ook"},{"id":"A1-M07-P1-012","module":"A1-M07 Demonstratives · P1","part":"P1 Foundation","stage":"Foundation","order":12,"level":"A1","topic":"Demonstrative adjective (far singular)","scenario":"That + singular noun + is + adjective","grammar":"That + tekil isim + sıfat","highlights":"","pattern":"","en":"That house looks old.","tr":"Şu ev eski görünüyor.","ipa":"/ðæt haʊs lʊks oʊld/","trPron":"Det haus luks old","tense":"Present Simple","collocations":"that house, house looks","synonyms":"home, dwelling","antonyms":"new, modern","commonMistake":"Those house looks old. ❌","aiExplain":"That tekil isimle kullanılır. \"Those\" ile kullanılmaz.","grammarTags":"demonstrative, adjective, singular","imgQuery":"old house on street"},{"id":"A1-M07-P1-013","module":"A1-M07 Demonstratives · P1","part":"P1 Foundation","stage":"Foundation","order":13,"level":"A1","topic":"Demonstrative adjective (near plural)","scenario":"These + plural noun + are + adjective","grammar":"These + çoğul isim + sıfat","highlights":"These apples are fresh.","pattern":"Present Simple","en":"these apples, apples are","tr":"apple, apples, apple tree","ipa":"fruit, snack","trPron":"rotten, stale","tense":"Descriptive","collocations":"These çoğul isimle kullanılır. \"This\" ile kullanılmaz.","synonyms":"crunch sound","antonyms":"demonstrative, adjective, plural","commonMistake":"A1","aiExplain":"","grammarTags":""},{"id":"A1-M07-P1-014","module":"A1-M07 Demonstratives · P1","part":"P1 Foundation","stage":"Foundation","order":14,"level":"A1","topic":"Demonstrative adjective (far plural)","scenario":"Those + plural noun + are + adjective","grammar":"Those + çoğul isim + sıfat","highlights":"","pattern":"","en":"Those shoes are expensive.","tr":"Şu ayakkabılar pahalı.","ipa":"/ðoʊz ʃuz ɑr ɪkˈspɛnsɪv/","trPron":"Doz şuz ar ikspensiv","tense":"Present Simple","collocations":"those shoes, shoes are","synonyms":"footwear, boot","antonyms":"cheap, inexpensive","commonMistake":"That shoes are expensive. ❌","aiExp