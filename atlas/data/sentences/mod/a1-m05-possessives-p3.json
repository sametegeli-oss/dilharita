[{"id":"A1-M05-P3-001","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":1,"level":"A1","topic":"Possession","scenario":"Using \"own\" for emphasis","grammar":"Possessive + own + noun","highlights":"Kendi... vurgusu","pattern":"","en":"I have my own room.","tr":"Kendi odam var.","ipa":"/aɪ hæv maɪ oʊn rum/","trPron":"Ay hev may own rum","tense":"Present Simple","collocations":"my own, own room","synonyms":"personal, private","antonyms":"shared, communal","commonMistake":"I have my room. ❌ (anlam farklı)","aiExplain":"My own başkasıyla paylaşmadığını vurgular.","grammarTags":"possessive, emphasis, own","imgQuery":"teenager in bedroom"},{"id":"A1-M05-P3-002","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":2,"level":"A1","topic":"Possession","scenario":"Using \"own\" for third person","grammar":"Possessive + own + noun","highlights":"Onun kendi...","pattern":"","en":"She has her own business.","tr":"Onun kendi işi var.","ipa":"/ʃiː hæz hɜr oʊn ˈbɪznəs/","trPron":"Şi haz hır own biznıs","tense":"Present Simple","collocations":"her own, own business","synonyms":"company, firm","antonyms":"none","commonMistake":"She has her business. ❌ (anlam farklı)","aiExplain":"Her own başkası için çalışmadığını vurgular.","grammarTags":"possessive, emphasis, work","imgQuery":"woman at office desk"},{"id":"A1-M05-P3-003","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":3,"level":"A1","topic":"Possession","scenario":"Possessive with gerund","grammar":"Possessive + gerund (A2 yapısı)","highlights":"Benim ...mem","pattern":"","en":"Do you mind my smoking?","tr":"Sigara içmemin bir sakıncası var mı?","ipa":"/duː juː maɪnd maɪ ˈsmoʊkɪŋ/","trPron":"Du yu maynd may smokİng","tense":"Present Simple","collocations":"my smoking, mind my","synonyms":"cigarette, fume","antonyms":"none","commonMistake":"Do you mind me smoking? ✔️ (daha az resmi)","aiExplain":"Resmi İngilizcede fiilimsi (-ing) öncesinde iyelik sıfatı kullanılır.","grammarTags":"possessive, gerund, formal","imgQuery":"person holding cigarette"},{"id":"A1-M05-P3-004","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":4,"level":"A1","topic":"Possession","scenario":"Possessive with of (formal)","grammar":"Noun + of + possessive pronoun (mine/yours etc.)","highlights":"Of ile iyelik (resmi)","pattern":"","en":"He is a friend of mine.","tr":"O benim arkadaşlarımdan biri.","ipa":"/hiː ɪz ə frɛnd əv maɪn/","trPron":"Hi iz ı frend ov mayn","tense":"Present Simple","collocations":"friend of mine, of mine","synonyms":"belonging to me","antonyms":"yours, his","commonMistake":"He is a friend of my. ❌","aiExplain":"Of my yanlıştır. \"Of mine\" doğrudur. \"Mine\" iyelik zamiridir.","grammarTags":"possessive, of-mine, pronoun","imgQuery":"two friends hugging"},{"id":"A1-M05-P3-005","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":5,"level":"A1","topic":"Possession","scenario":"Possessive with of + name (formal)","grammar":"Noun + of + name","highlights":"İsmin of ile iyeliği","pattern":"","en":"That is the car of Mr. Smith.","tr":"Şu Bay Smith'in arabası.","ipa":"/ðæt ɪz ðə kɑr əv ˈmɪstər smɪθ/","trPron":"Det iz dı kar ov mistır Smith","tense":"Present Simple","collocations":"car of Mr., of Mr. Smith","synonyms":"vehicle, automobile","antonyms":"none","commonMistake":"That is Mr. Smith's car. ✔️ (daha yaygın)","aiExplain":"Car of Mr. Smith resmi ama doğrudur. 's daha yaygındır.","grammarTags":"possessive, formal, of","imgQuery":"expensive car in driveway"},{"id":"A1-M05-P3-006","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":6,"level":"A1","topic":"Possession","scenario":"Possessive with whose (question)","grammar":"Whose + noun + be + ...?","highlights":"Kimin sorusu","pattern":"","en":"Whose bag is this?","tr":"Bu kimin çantası?","ipa":"/huz bæg ɪz ðɪs/","trPron":"Huz bag iz dis","tense":"Present Simple","collocations":"whose bag, bag is this","synonyms":"belonging to whom","antonyms":"none","commonMistake":"Who is this bag? ❌ (anlam farklı)","aiExplain":"Whose sahiplik sorusu için kullanılır. \"Who is this bag?\" anlamsızdır.","grammarTags":"possessive, question, whose","imgQuery":"hand holding unknown bag"},{"id":"A1-M05-P3-007","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":7,"level":"A1","topic":"Possession","scenario":"Answering whose question","grammar":"It is + possessive pronoun (mine/yours)","highlights":"İyelik zamiri ile cevap","pattern":"Present Simple","en":"it is mine, is mine","tr":"mine, my, myself","ipa":"belonging to me","trPron":"yours, his","tense":"Neutral","collocations":"It is my yanlıştır çünkü \"my\" isimden önce gelir. \"Mine\" tek başına kullanılır.","synonyms":"positive tone sound","antonyms":"possessive, pronoun, answer","commonMistake":"A1","aiExplain":"","grammarTags":""},{"id":"A1-M05-P3-008","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":8,"level":"A1","topic":"Possession","scenario":"Possessive pronouns (yours)","grammar":"Yours ile sahiplik","highlights":"","pattern":"Present Simple","en":"is yours, pen is yours","tr":"yours, your, yourself","ipa":"belonging to you","trPron":"mine, his","tense":"Neutral","collocations":"This pen is your yanlıştır.","synonyms":"pen clicking sound","antonyms":"possessive, pronoun, yours","commonMistake":"A1","aiExplain":"","grammarTags":""},{"id":"A1-M05-P3-009","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":9,"level":"A1","topic":"Possession","scenario":"Possessive pronouns (his/hers)","grammar":"His/Hers ile sahiplik","highlights":"","pattern":"","en":"The blue car is his. The red one is hers.","tr":"Mavi araba onunki. Kırmızı olan onunki (kadın).","ipa":"/ðə blu kɑr ɪz hɪz ðə rɛd wʌn ɪz hɜrz/","trPron":"Dı blu kar iz hiz dı red van iz hırz","tense":"Present Simple","collocations":"is his, is hers","synonyms":"belonging to him/her","antonyms":"mine, yours","commonMistake":"The blue car is him. ❌","aiExplain":"His ve \"hers\" iyelik zamirleri isimsiz kullanılır.","grammarTags":"possessive, pronoun, gender","imgQuery":"two cars blue and red"},{"id":"A1-M05-P3-010","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":10,"level":"A1","topic":"Possession","scenario":"Possessive pronouns (ours/theirs)","grammar":"Ours/theirs ile sahiplik","highlights":"","pattern":"","en":"The victory is ours, not theirs.","tr":"Zafer bizimki, onlarınki değil.","ipa":"/ðə ˈvɪktəri ɪz ˈaʊərz nɑt ðɛrz/","trPron":"Dı viktıri iz auırz nat derz","tense":"Present Simple","collocations":"is ours, is theirs","synonyms":"belonging to us","antonyms":"yours, his","commonMistake":"The victory is our, not their. ❌","aiExplain":"Our ve \"their\" iyelik sıfatlarıdır, isimden önce gelir.","grammarTags":"possessive, pronoun, plural","imgQuery":"team holding trophy"},{"id":"A1-M05-P3-011","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":11,"level":"A1","topic":"Possession","scenario":"Double possessive (friend of John's)","grammar":"Noun + of + name + 's (çift iyelik)","highlights":"John'un arkadaşı yapısı","pattern":"","en":"He is a friend of John's.","tr":"O John'un arkadaşlarından biri.","ipa":"/hiː ɪz ə frɛnd əv ˈʤɑnz/","trPron":"Hi iz ı frend ov Canz","tense":"Present Simple","collocations":"friend of John's, of John's","synonyms":"companion, pal","antonyms":"enemy, foe","commonMistake":"He is a friend of John. ✔️ (farklı anlam)","aiExplain":"Friend of John John'un arkadaşı (tekil). \"Friend of John's\" John'un arkadaşlarından biri (çoklu arkadaşları var anlamında).","grammarTags":"possessive, double-possessive, apostrophe","imgQuery":"two men shaking hands"},{"id":"A1-M05-P3-012","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":12,"level":"A1","topic":"Possession","scenario":"Possessive with \"of\" and possessive pronoun","grammar":"Of + possessive pronoun","highlights":"...lerinden biri","pattern":"","en":"That sister of yours is very funny.","tr":"Şu senin kız kardeşin çok komik.","ipa":"/ðæt ˈsɪstər əv jʊrz ɪz ˈvɛri ˈfʌni/","trPron":"Det sistır ov yurz iz veri fani","tense":"Present Simple","collocations":"sister of yours, of yours","synonyms":"belonging to you","antonyms":"mine, his","commonMistake":"That sister of your is very funny. ❌","aiExplain":"Of yours doğru, \"of your\" yanlıştır.","grammarTags":"possessive, of-yours, pronoun","imgQuery":"two sisters laughing"},{"id":"A1-M05-P3-013","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":13,"level":"A1","topic":"Possession","scenario":"Possessive with no noun (absolute possessive)","grammar":"Possessive pronoun alone","highlights":"İsimsiz iyelik zamiri","pattern":"","en":"My phone is new. Hers is old.","tr":"Benim telefonum yeni. Onunki (kadın) eski.","ipa":"/maɪ foʊn ɪz nu hɜrz ɪz oʊld/","trPron":"May fon iz nu hırz iz old","tense":"Present Simple","collocations":"mine is, hers is","synonyms":"belonging to her","antonyms":"mine, his","commonMistake":"Hers phone is old. ❌","aiExplain":"Hers tek başına kullanılır, isimden önce kullanılmaz. \"Her phone\" doğrudur.","grammarTags":"possessive, pronoun, absolute","imgQuery":"two phones new and old"},{"id":"A1-M05-P3-014","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":14,"level":"A1","topic":"Possession","scenario":"Possessive with apostrophe after plural -s (s')","grammar":"Plural noun + ' + noun (çoğul iyelik)","highlights":"Çoğul iyelik (s')","pattern":"","en":"My parents' house is near the sea.","tr":"Annem babamın evi denize yakın.","ipa":"/maɪ ˈpɛrənts haʊs ɪz nɪr ðə si/","trPron":"May perınts haus iz nir dı si","tense":"Present Simple","collocations":"parents' house, house is","synonyms":"home, dwelling","antonyms":"apartment, none","commonMistake":"My parent's house is near the sea. ❌ (tek ebeveyn)","aiExplain":"Çoğul isimlerde iyelik için kesme işareti s'den sonra gelir.","grammarTags":"possessive, plural-apostrophe, location","imgQuery":"house by the sea"},{"id":"A1-M05-P3-015","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":15,"level":"A1","topic":"Possession","scenario":"Possessive with irregular plurals (children's)","grammar":"Düzensiz çoğullarda iyelik (children's)","highlights":"Çocukların iyeliği","pattern":"","en":"The children's toys are everywhere.","tr":"Çocukların oyuncakları her yerde.","ipa":"/ðə ˈʧɪldrənz tɔɪz ɑr ˈɛvriˌwɛr/","trPron":"Dı çıldrınz toys ar evrivır","tense":"Present Simple","collocations":"children's toys, toys are","synonyms":"plaything, game","antonyms":"none","commonMistake":"The childrens' toys are everywhere. ❌","aiExplain":"Düzensiz çoğullar (children, men, women) iyelik için 's alır, s' değil.","grammarTags":"possessive, irregular-plural, apostrophe","imgQuery":"living room with toys on floor"},{"id":"A1-M05-P3-016","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":16,"level":"A1","topic":"Possession","scenario":"Possessive with names ending in s (Jesus')","grammar":"S ile biten isimlerde iyelik","highlights":"","pattern":"","en":"Jesus' teachings are famous.","tr":"İsa'nın öğretileri ünlüdür.","ipa":"/ˈʤizəz ˈtiʧɪŋz ɑr ˈfeɪməs/","trPron":"Cizız tiçİngz ar feymıs","tense":"Present Simple","collocations":"Jesus' teachings, teachings are","synonyms":"lessons, doctrines","antonyms":"none","commonMistake":"Jesus's teachings are famous. ✔️ (kabul edilir)","aiExplain":"Tarihi/ünlü isimlerde genellikle sadece kesme işareti kullanılır.","grammarTags":"possessive, name-s, historical","imgQuery":"ancient religious book"},{"id":"A1-M05-P3-017","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":17,"level":"A1","topic":"Possession","scenario":"Possessive with compound nouns","grammar":"Compound noun + 's (birlikte iyelik)","highlights":"Bileşik isimlerde iyelik","pattern":"","en":"My brother-in-law's car is new.","tr":"Eniştemin arabası yeni.","ipa":"/maɪ ˈbrʌðər ɪn lɔz kɑr ɪz nu/","trPron":"May brazır in loz kar iz nu","tense":"Present Simple","collocations":"brother-in-law's car, car is","synonyms":"vehicle, automobile","antonyms":"none","commonMistake":"My brother's-in-law car is new. ❌","aiExplain":"Bileşik isimlerde iyelik eki en son kelimeye eklenir.","grammarTags":"possessive, compound-noun, apostrophe","imgQuery":"family with new car"},{"id":"A1-M05-P3-018","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":18,"level":"A1","topic":"Possession","scenario":"Possessive with time expressions (today's)","grammar":"Zaman ifadelerinde iyelik","highlights":"","pattern":"","en":"Today's weather is sunny.","tr":"Bugünün havası güneşli.","ipa":"/təˈdeɪz ˈwɛðər ɪz ˈsʌni/","trPron":"Tudeys vedır iz sani","tense":"Present Simple","collocations":"today's weather, weather is","synonyms":"climate, conditions","antonyms":"none","commonMistake":"The weather of today is sunny. ✔️ (doğru da)","aiExplain":"Zaman ifadelerinde 's yaygındır.","grammarTags":"possessive, time, apostrophe","imgQuery":"sunny day with blue sky"},{"id":"A1-M05-P3-019","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":19,"level":"A1","topic":"Possession","scenario":"Possessive with \"one another's\"","grammar":"One another's ile karşılıklı iyelik","highlights":"","pattern":"","en":"They know one another's secrets.","tr":"Birbirlerinin sırlarını bilirler.","ipa":"/ðeɪ noʊ wʌn əˈnʌðərz ˈsikrəts/","trPron":"Dey no van anazırz sikrıts","tense":"Present Simple","collocations":"one another's, one another's secrets","synonyms":"confidence, mystery","antonyms":"none","commonMistake":"They know one anothers' secrets. ❌","aiExplain":"One another's doğru yazımdır.","grammarTags":"possessive, reciprocal, apostrophe","imgQuery":"two friends whispering"},{"id":"A1-M05-P3-020","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":20,"level":"A1","topic":"Possession","scenario":"Possessive with which (question)","grammar":"Which + noun + 's + noun?","highlights":"Hangi ismin iyeliği","pattern":"sorusu","en":"Which student's phone is ringing?","tr":"Hangi öğrencinin telefonu çalıyor?","ipa":"/wɪʧ ˈstudənts foʊn ɪz ˈrɪŋɪŋ/","trPron":"Viç studınts fon iz ringİng","tense":"Present Simple","collocations":"which student's, student's phone","synonyms":"cell, mobile","antonyms":"none","commonMistake":"Which student phone is ringing? ❌","aiExplain":"Which student phone iyelik eki olmadan anlamı değiştirir.","grammarTags":"possessive, question, which","imgQuery":"student with ringing phone"},{"id":"A1-M05-P3-021","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":21,"level":"A1","topic":"Possession","scenario":"Possessive with else (somebody else's)","grammar":"Else ile iyelik (başkasının)","highlights":"","pattern":"","en":"This is somebody else's coat.","tr":"Bu başka birinin ceketi.","ipa":"/ðɪs ɪz ˈsʌmbədi ɛlsɪz koʊt/","trPron":"Dis iz sambadi elsiz kout","tense":"Present Simple","collocations":"somebody else's, else's coat","synonyms":"jacket, outerwear","antonyms":"none","commonMistake":"This is somebody's else coat. ❌","aiExplain":"İyelik eki \"else\" kelimesine eklenir.","grammarTags":"possessive, else, apostrophe","imgQuery":"coat on coat rack"},{"id":"A1-M05-P3-022","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":22,"level":"A1","topic":"Possession","scenario":"Possessive with each other's","grammar":"Each other's ile karşılıklı iyelik","highlights":"","pattern":"","en":"They read each other's messages.","tr":"Birbirlerinin mesajlarını okurlar.","ipa":"/ðeɪ rid iːʧ ˈʌðərz ˈmɛsəʤəz/","trPron":"Dey rid iç azırz mesacız","tense":"Present Simple","collocations":"each other's, each other's messages","synonyms":"text, note","antonyms":"none","commonMistake":"They read each others' messages. ❌","aiExplain":"Each other's doğru yazımdır.","grammarTags":"possessive, reciprocal, apostrophe","imgQuery":"two people looking at phones"},{"id":"A1-M05-P3-023","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":23,"level":"A1","topic":"Possession","scenario":"Possessive with of which (formal)","grammar":"Of which ile iyelik (resmi)","highlights":"","pattern":"","en":"The color of which I am fond is blue.","tr":"Sevdiğim renk mavidir.","ipa":"/ðə ˈkʌlər əv wɪʧ aɪ æm fɑnd ɪz blu/","trPron":"Dı kalır ov viç ay em fond iz blu","tense":"Present Simple","collocations":"color of which, of which","synonyms":"that, whom","antonyms":"none","commonMistake":"The color whose I am fond is blue. ❌","aiExplain":"Of which resmi bir yapıdır. Günlük dilde \"that\" kullanılır.","grammarTags":"possessive, formal, of-which","imgQuery":"blue color swatch"},{"id":"A1-M05-P3-024","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":24,"level":"A1","topic":"Possession","scenario":"Possessive with \"of\" for inanimate objects (preferred)","grammar":"Cansız nesneler için of tercihi","highlights":"","pattern":"","en":"The door of the house is open.","tr":"Evin kapısı açık.","ipa":"/ðə dɔr əv ðə haʊs ɪz ˈoʊpən/","trPron":"Dı dor ov dı haus iz open","tense":"Present Simple","collocations":"door of the, of the house","synonyms":"entrance, gate","antonyms":"none","commonMistake":"The house's door is open. ✔️ (kabul edilir)","aiExplain":"Cansız nesneler için 's yerine \"of\" daha yaygındır ama 's da kabul edilir.","grammarTags":"possessive, inanimate, of","imgQuery":"house with open door"},{"id":"A1-M05-P3-025","module":"A1-M05 Possessives · P3","part":"P3 Expansion","stage":"Expansion","order":25,"level":"A1","topic":"Possession","scenario":"Possessive with apostrophe for duration (two weeks' notice)","grammar":"Süre ifadelerinde iyelik (haftanın)","highlights":"","pattern":"","en":"I gave two weeks' notice.","tr":"İki haftalık bildirim verdim.","ipa":"/aɪ geɪv tuː wiks ˈnoʊtɪs/","trPron":"Ay geyv tu viks notis","tense":"Past Simple","collocations":"two weeks' notice, weeks' notice","synonyms":"seven days, duration","antonyms":"none","commonMistake":"I gave two weeks notice. ❌","aiExplain":"Süre ifadelerinde iyelik eki kullanılır.","grammarTags":"possessive, duration, apostrophe","imgQuery":"resignation letter on desk"}]