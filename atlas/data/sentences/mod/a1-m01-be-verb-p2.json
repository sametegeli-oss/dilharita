[{"id":"A1-M01-P2-001","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":1,"level":"A1","topic":"Profession","scenario":"Job interview","grammar":"Subject + be verb + article + noun","highlights":"I ile \"am\" kullanımı tekrarı","pattern":"","en":"I am a software developer.","tr":"Ben bir yazılım geliştiricisiyim.","ipa":"/aɪ æm ə ˈsɔftwɛr dɪˈvɛləpər/","trPron":"Ay em ı softver divelopır","tense":"Present Simple","collocations":"software developer, work as developer","synonyms":"engineer, programmer","antonyms":"tester, user","commonMistake":"I am software developer. ❌","aiExplain":"Meslek belirtirken \"a\" kullanılır. \"I am software developer\" yanlıştır.","grammarTags":"be, article, profession","imgQuery":"person coding on computer"},{"id":"A1-M01-P2-002","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":2,"level":"A1","topic":"Nationality","scenario":"Talking about origin","grammar":"Subject + be verb + from + country","highlights":"Ülke isimlerinden önce \"from\"","pattern":"","en":"They are from Italy.","tr":"Onlar İtalya’dan.","ipa":"/ðeɪ ɑr frʌm ˈɪtəli/","trPron":"Dey ar fıram İtaly","tense":"Present Simple","collocations":"from Italy, come from Italy","synonyms":"the boot, Italia","antonyms":"none","commonMistake":"They are Italy. ❌","aiExplain":"She is Turkey hatasını düzeltir. \"They are Italy\" yanlış, \"from\" şart.","grammarTags":"be, preposition, country","imgQuery":"people with Italian flag"},{"id":"A1-M01-P2-003","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":3,"level":"A1","topic":"Feelings","scenario":"Morning greeting","grammar":"Subject + be verb + adjective","highlights":"Negatif formda \"not\" yeri","pattern":"","en":"I am not tired this morning.","tr":"Bu sabah yorgun değilim.","ipa":"/aɪ æm nɑt ˈtaɪərd ðɪs ˈmɔrnɪŋ/","trPron":"Ay em nat tayırd dis mornin","tense":"Present Simple","collocations":"not tired, feel tired","synonyms":"exhausted, weary","antonyms":"energetic, rested","commonMistake":"I not am tired. ❌","aiExplain":"Negatif cümlede \"not\" yardımcı fiilden hemen sonra gelir. \"I not am\" yanlıştır.","grammarTags":"be, negative, adjective","imgQuery":"person stretching in bed"},{"id":"A1-M01-P2-004","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":4,"level":"A1","topic":"Location","scenario":"Looking for keys","grammar":"Subject + be verb + preposition + noun","highlights":"Kısa sorularda \"Where is\"","pattern":"","en":"Where are my keys?","tr":"Anahtarlarım nerede?","ipa":"/wɛr ɑr maɪ kiz/","trPron":"Ver ar may kiz","tense":"Present Simple","collocations":"where are, car keys","synonyms":"opener, lock","antonyms":"none","commonMistake":"Where my keys are? ❌","aiExplain":"Soru kelimesi + be fiili + özne. \"Where my keys are?\" yanlış sıralama.","grammarTags":"be, question, location","imgQuery":"hand searching in bag"},{"id":"A1-M01-P2-005","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":5,"level":"A1","topic":"Identification","scenario":"Meeting a pet","grammar":"Subject + be verb + name + possessive","highlights":"Hayvanlar için \"it\"","pattern":"","en":"It is my dog, Max.","tr":"O benim köpeğim Max.","ipa":"/ɪt ɪz maɪ dɔg mæks/","trPron":"İt iz may dog Meks","tense":"Present Simple","collocations":"my dog, walk the dog","synonyms":"puppy, canine","antonyms":"cat, none","commonMistake":"He is my dog Max. ❌ (kabul edilebilir ama \"it\" daha temel)","aiExplain":"Cinsiyeti bilinmeyen veya önemsiz hayvanlar için \"it\" kullanılır.","grammarTags":"be, pronoun, pet","imgQuery":"person petting a golden retriever"},{"id":"A1-M01-P2-006","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":6,"level":"A1","topic":"Plural","scenario":"Describing a crowd","grammar":"Subject + be verb (plural) + noun + location","highlights":"Çoğul özne + çoğul yer","pattern":"","en":"The people are in the stadium.","tr":"İnsanlar stadyumda.","ipa":"/ðə ˈpipəl ɑr ɪn ðə ˈsteɪdiəm/","trPron":"Dı pipıl ar in dı steydiyım","tense":"Present Simple","collocations":"people are, in the stadium","synonyms":"crowd, public","antonyms":"individual, person (sg)","commonMistake":"The people is in the stadium. ❌","aiExplain":"People çoğul bir isimdir. \"People is\" yanlıştır. Doğrusu \"people are\" olmalıdır.","grammarTags":"be, plural, location","imgQuery":"crowd cheering in stadium"},{"id":"A1-M01-P2-007","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":7,"level":"A1","topic":"Price","scenario":"Asking about cost","grammar":"Subject + be verb + number + currency","highlights":"Fiyat sormada \"How much is\"","pattern":"","en":"How much is this T-shirt?","tr":"Bu tişört ne kadar?","ipa":"/haʊ mʌʧ ɪz ðɪs tiː ʃɜrt/","trPron":"Hav maç iz dis ti şırt","tense":"Present Simple","collocations":"how much, buy a T-shirt","synonyms":"top, garment","antonyms":"pants, none","commonMistake":"How many is this T-shirt? ❌","aiExplain":"Much sayılamayanlar (para) için, \"many\" sayılabilenler için. Fiyat sorarken \"How much\" kullanılır.","grammarTags":"be, question, price","imgQuery":"person holding T-shirt in store"},{"id":"A1-M01-P2-008","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":8,"level":"A1","topic":"Confirmation","scenario":"Asking about identity","grammar":"Question with \"Is this\"","highlights":"Bu ... mi? sorusu","pattern":"","en":"Is this your bag?","tr":"Bu senin çantan mı?","ipa":"/ɪz ðɪs jʊr bæg/","trPron":"İz dis yur bag","tense":"Present Simple","collocations":"your bag, carry a bag","synonyms":"purse, backpack","antonyms":"none","commonMistake":"This your bag? ❌","aiExplain":"Soru cümlesinde \"Is\" başa gelir. \"This your bag?\" soru işareti olsa bile yanlıştır.","grammarTags":"be, question, possessive","imgQuery":"person pointing at a suitcase"},{"id":"A1-M01-P2-009","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":9,"level":"A1","topic":"Location","scenario":"Answering phone","grammar":"Short answer with \"it is\"","highlights":"Kısa cevapta \"it is\"","pattern":"Present Simple","en":"it is me, it's me","tr":"me, myself","ipa":"I, myself","trPron":"you, them","tense":"A1","collocations":"Informal","synonyms":"Telefonda veya kapıda \"It is me\" doğru ve doğaldır. \"It is I\" dilbilgisel olarak doğru ama çok resmidir.","antonyms":"person talking on phone","commonMistake":"P1","aiExplain":"phone ringing sound","grammarTags":"","imgQuery":"be, pronoun, short-answer"},{"id":"A1-M01-P2-010","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":10,"level":"A1","topic":"Description","scenario":"Describing weather","grammar":"Subject + be verb + adjective + weather noun","highlights":"Hava durumu için \"It is\"","pattern":"","en":"It is a cold day.","tr":"Soğuk bir gün.","ipa":"/ɪt ɪz ə koʊld deɪ/","trPron":"İt iz ı kold dey","tense":"Present Simple","collocations":"cold day, very cold","synonyms":"chilly, freezing","antonyms":"hot, warm","commonMistake":"Is a cold day. ❌","aiExplain":"Hava durumu ve zaman ifadelerinde \"It\" öznesi şarttır. \"Is a cold day\" yanlıştır.","grammarTags":"be, weather, pronoun","imgQuery":"thermometer showing low temperature"},{"id":"A1-M01-P2-011","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":11,"level":"A1","topic":"Profession","scenario":"Family introduction","grammar":"Plural subject + plural noun + \"all\"","highlights":"Hepsi anlamında \"all\"","pattern":"","en":"We are all teachers.","tr":"Hepimiz öğretmeniz.","ipa":"/wi ɑr ɔl ˈtiʧərz/","trPron":"Wi ar ol tiçırz","tense":"Present Simple","collocations":"all teachers, we all","synonyms":"everyone, everybody","antonyms":"none, not all","commonMistake":"We are all teacher. ❌","aiExplain":"All teachers çoğul isim gerektirir. \"We are all teacher\" yanlıştır.","grammarTags":"be, plural, quantifier","imgQuery":"group of teachers holding books"},{"id":"A1-M01-P2-012","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":12,"level":"A1","topic":"Feelings","scenario":"Asking about health","grammar":"Question with \"Are you\"","highlights":"Are you ile sağlık sorma","pattern":"","en":"Are you okay? You look pale.","tr":"İyi misin? Solgun görünüyorsun.","ipa":"/ɑr juː oʊˈkeɪ juː lʊk peɪl/","trPron":"Ar yu okey yu luk peyl","tense":"Present Simple","collocations":"are you okay, feel okay","synonyms":"fine, alright","antonyms":"bad, sick","commonMistake":"You okay? ❌ (konuşma dilinde geçer ama yazıda yanlış)","aiExplain":"Resmi olmayan konuşmada \"You okay?\" kullanılabilir ama standart İngilizcede \"Are you okay?\" doğrudur.","grammarTags":"be, question, health","imgQuery":"person touching forehead"},{"id":"A1-M01-P2-013","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":13,"level":"A1","topic":"Negation","scenario":"Denying something","grammar":"Negative with \"not\" + \"any\"","highlights":"Negatif cümlede \"any\" kullanımı","pattern":"","en":"There aren't any cookies left.","tr":"Hiç kurabiye kalmadı.","ipa":"/ðɛr ɑrnt ˈɛni ˈkʊkiz lɛft/","trPron":"Der arnt eni kukiz left","tense":"Present Simple","collocations":"any left, cookies left","synonyms":"biscuit, snack","antonyms":"none","commonMistake":"There aren't no cookies. ❌","aiExplain":"Negatif cümlede \"any\" kullanılır, \"no\" kullanılmaz. \"There aren't no cookies\" çift negatif yapar ve yanlıştır.","grammarTags":"be, negative, quantifier","imgQuery":"empty cookie jar on counter"},{"id":"A1-M01-P2-014","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":14,"level":"A1","topic":"Possession","scenario":"Lost item report","grammar":"Possessive with \"mine/yours\"","highlights":"İyelik zamirleri (isim olmadan)","pattern":"","en":"This pen is mine, not yours.","tr":"Bu kalem benimki, seninki değil.","ipa":"/ðɪs pɛn ɪz maɪn nɑt jʊrz/","trPron":"Dis pen iz mayn nat yurz","tense":"Present Simple","collocations":"mine not yours, this is mine","synonyms":"yours, his, hers, ours, theirs","antonyms":"his, hers","commonMistake":"This pen is my, not your. ❌","aiExplain":"Mine tek başına kullanılır, \"my\" isimden önce kullanılır. \"This pen is my\" yanlıştır.","grammarTags":"be, possessive, pronoun","imgQuery":"two hands reaching for a pen"},{"id":"A1-M01-P2-015","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":15,"level":"A1","topic":"Existence","scenario":"Describing a town","grammar":"There is/are contrast","highlights":"Tekil/çoğul farkı ile \"there is/are\"","pattern":"","en":"There is a bank and there are two shops.","tr":"Bir banka ve iki dükkan var.","ipa":"/ðɛr ɪz ə bæŋk ænd ðɛr ɑr tuː ʃɑps/","trPron":"Der iz ı bank end der ar tu şops","tense":"Present Simple","collocations":"there is, there are","synonyms":"financial institution","antonyms":"none","commonMistake":"There is two shops. ❌","aiExplain":"Two shops çoğul olduğu için \"there are\" kullanılır. \"There is two shops\" yaygın bir hatadır.","grammarTags":"be, there-is, there-are","imgQuery":"street with bank and small shops"},{"id":"A1-M01-P2-016","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":16,"level":"A1","topic":"Identity","scenario":"Phone call","grammar":"Subject + be verb + name (on phone)","highlights":"Telefonda \"This is\" kullanımı","pattern":"","en":"Hello, this is Maria from ABC Corp.","tr":"Alo, ben ABC Şirketi'nden Maria.","ipa":"/hɛˈloʊ ðɪs ɪz mɑˈriə frʌm eɪ biː siː kɔrp/","trPron":"Helo dis iz Mariya fıram ey bi si korp","tense":"Present Simple","collocations":"this is, from ABC Corp","synonyms":"company, firm","antonyms":"none","commonMistake":"Hello, I am Maria. ❌ (telefonda yanlış)","aiExplain":"Telefonda kendini tanıtırken \"This is\" kullanılır. \"I am\" yüz yüze konuşma içindir.","grammarTags":"be, telephone, introduction","imgQuery":"person holding phone to ear"},{"id":"A1-M01-P2-017","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":17,"level":"A1","topic":"Description","scenario":"Describing a friend","grammar":"Subject + be verb + adjective + noun","highlights":"Sıfat + isim sıralaması","pattern":"","en":"She is a nice person.","tr":"O iyi bir insan.","ipa":"/ʃiː ɪz ə naɪs ˈpɜrsən/","trPron":"Şi iz ı nays pörsın","tense":"Present Simple","collocations":"nice person, very nice","synonyms":"kind, friendly","antonyms":"mean, rude","commonMistake":"She is nice person. ❌","aiExplain":"Nice person sayılabilir tekil isim olduğu için \"a\" gerekir. \"She is nice person\" yanlıştır.","grammarTags":"be, article, adjective","imgQuery":"two friends laughing together"},{"id":"A1-M01-P2-018","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":18,"level":"A1","topic":"Location","scenario":"Asking for a person","grammar":"Question with \"Is + name\"","highlights":"İsmi ... mi? sorusu","pattern":"","en":"Is Mr. Johnson in his office?","tr":"Bay Johnson ofisinde mi?","ipa":"/ɪz ˈmɪstər ˈʤɑnsən ɪn hɪz ˈɔfɪs/","trPron":"İz Mistır Cansın in hiz ofis","tense":"Present Simple","collocations":"in his office, call his office","synonyms":"workplace, desk","antonyms":"home, out","commonMistake":"Mr. Johnson is in his office? ❌","aiExplain":"Is başa gelmeli. \"Mr. Johnson is in his office?\" soru işareti olsa bile yanlış sıralamadır.","grammarTags":"be, question, location","imgQuery":"empty office desk with nameplate"},{"id":"A1-M01-P2-019","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":19,"level":"A1","topic":"Feelings","scenario":"Expressing happiness","grammar":"Subject + be verb + very + adjective","highlights":"Very ile güçlendirme","pattern":"","en":"We are very happy to be here.","tr":"Burada olduğumuz için çok mutluyuz.","ipa":"/wi ɑr ˈvɛri ˈhæpi tu bi hɪr/","trPron":"Wi ar veri hepi tu bi hir","tense":"Present Simple","collocations":"very happy, happy to be","synonyms":"glad, delighted","antonyms":"sad, unhappy","commonMistake":"We very happy. ❌","aiExplain":"Very bir sıfatı güçlendirir ama fiilin yerini tutamaz. \"We very happy\" yanlıştır.","grammarTags":"be, adverb, adjective","imgQuery":"family hugging in living room"},{"id":"A1-M01-P2-020","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":20,"level":"A1","topic":"Occupation","scenario":"Job rejection","grammar":"Negative with \"not a\"","highlights":"Not a ile meslek reddi","pattern":"","en":"I am not a chef; I am a cook.","tr":"Ben aşçı değilim; ben bir (basit) aşçıyım.","ipa":"/aɪ æm nɑt ə ʃɛf aɪ æm ə kʊk/","trPron":"Ay em nat ı şef ay em ı kuk","tense":"Present Simple","collocations":"not a chef, work as cook","synonyms":"cook, culinary artist","antonyms":"dishwasher, none","commonMistake":"I am not chef. ❌","aiExplain":"Not dan sonra da \"a\" kullanılır. \"I am not chef\" yanlıştır.","grammarTags":"be, negative, article","imgQuery":"cook in apron holding pan"},{"id":"A1-M01-P2-021","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":21,"level":"A1","topic":"Time","scenario":"Asking about time","grammar":"What time + is + it?","highlights":"Saat sorma kalıbı","pattern":"","en":"What time is it?","tr":"Saat kaç?","ipa":"/wʌt taɪm ɪz ɪt/","trPron":"Vat taym iz it","tense":"Present Simple","collocations":"what time, tell the time","synonyms":"hour, clock","antonyms":"none","commonMistake":"What time it is? ❌","aiExplain":"Soru kelimesi + be + özne. \"What time it is?\" yanlış, \"it is\" özne-fiil sırası soruda ters döner.","grammarTags":"be, question, time","imgQuery":"clock on wall showing 3:00"},{"id":"A1-M01-P2-022","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":22,"level":"A1","topic":"Existence","scenario":"Hotel reception","grammar":"Is there sorusu","highlights":"Tekil varlık sorusu","pattern":"","en":"Is there a gym in this hotel?","tr":"Bu otelde spor salonu var mı?","ipa":"/ɪz ðɛr ə ʤɪm ɪn ðɪs hoʊˈtɛl/","trPron":"İz der ı cim in dis hotel","tense":"Present Simple","collocations":"is there, in this hotel","synonyms":"fitness center","antonyms":"none","commonMistake":"Does it have a gym? ❌ (doğru ama farklı yapı)","aiExplain":"Varlık sorusu \"Is there\" ile yapılır. \"Does it have\" farklı bir yapıdır ve daha ileri seviyedir.","grammarTags":"be, there-is, question","imgQuery":"hotel gym with treadmill"},{"id":"A1-M01-P2-023","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":23,"level":"A1","topic":"Plural question","scenario":"Asking about multiple items","grammar":"Are there sorusu","highlights":"Çoğul varlık sorusu","pattern":"","en":"Are there any vegetarian options?","tr":"Vejetaryen seçenekler var mı?","ipa":"/ɑr ðɛr ˈɛni ˌvɛʤɪˈtɛriən ˈɑpʃənz/","trPron":"Ar der eni veciteryın opşınz","tense":"Present Simple","collocations":"any options, vegetarian options","synonyms":"choice, alternative","antonyms":"none, no choice","commonMistake":"Is there any vegetarian options? ❌","aiExplain":"Options çoğul olduğu için \"Are there\" kullanılır. \"Is there any options\" yaygın bir hatadır.","grammarTags":"be, there-are, question","imgQuery":"restaurant menu with salad"},{"id":"A1-M01-P2-024","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":24,"level":"A1","topic":"Possession","scenario":"Finding owner","grammar":"Is this yours? kalıbı","highlights":"Is this ile sahiplik sorusu","pattern":"","en":"Is this phone yours or his?","tr":"Bu telefon senin mi yoksa onun mu?","ipa":"/ɪz ðɪs foʊn jʊrz ɔr hɪz/","trPron":"İz dis fon yurz or hiz","tense":"Present Simple","collocations":"yours or his, this phone","synonyms":"cell, mobile","antonyms":"none","commonMistake":"Is this phone your or her? ❌","aiExplain":"Yours ve \"his\" iyelik zamirleri isimsiz kullanılır. \"Your\" ve \"her\" isimden önce kullanılır.","grammarTags":"be, question, possessive","imgQuery":"hand holding lost phone"},{"id":"A1-M01-P2-025","module":"A1-M01 Be Verb · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":25,"level":"A1","topic":"Introduction","scenario":"Meeting a group","grammar":"Subject + be verb + name + everyone","highlights":"Herkese tanıtma","pattern":"","en":"Hi everyone, I am your new teacher.","tr":"Herkese merhaba, ben yeni öğretmeninizim.","ipa":"/haɪ ˈɛvriˌwʌn aɪ æm jʊr nuː ˈtiʧər/","trPron":"Hay evrivın ay em yur nu tiçır","tense":"Present Simple","collocations":"your teacher, new teacher","synonyms":"instructor, educator","antonyms":"student, pupil","commonMistake":"Hi everyone, I your new teacher. ❌","aiExplain":"Tanışma cümlesinde \"am\" şarttır. \"I your teacher\" yanlıştır.","grammarTags":"be, introduction, profession","imgQuery":"smiling teacher in front of class"}]