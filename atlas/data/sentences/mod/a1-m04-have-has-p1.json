positive","antonyms":"no, not","commonMistake":"Yes, I have. ❌","aiExplain":"Do you have? sorusuna kısa cevap \"Yes, I do\"dur. \"Yes, I have\" yanlış veya çok resmidir.","grammarTags":"have, short-answer, auxiliary","imgQuery":"person nodding head"},{"id":"A1-M04-P1-021","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":21,"level":"A1","topic":"Possession","scenario":"Short answer (no)","grammar":"No + subject + don't/doesn't","highlights":"Kısa cevap - olumsuz","pattern":"","en":"No, I don't.","tr":"Hayır, yok.","ipa":"/noʊ aɪ doʊnt/","trPron":"No ay dont","tense":"Present Simple","collocations":"no I don't, I don't","synonyms":"negative, no","antonyms":"yes, do","commonMistake":"No, I haven't. ❌","aiExplain":"Do you have? sorusuna kısa cevap \"No, I don't\"dur. \"No, I haven't\" yanlıştır.","grammarTags":"have, short-answer, auxiliary","imgQuery":"person shaking head"},{"id":"A1-M04-P1-022","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":22,"level":"A1","topic":"Possession","scenario":"Third person singular negative","grammar":"He + doesn't have + noun","highlights":"Doesn't have ile üçüncü tekil negatif","pattern":"","en":"He doesn't have a job.","tr":"Onun işi yok.","ipa":"/hiː ˈdʌzənt hæv ə ʤɑb/","trPron":"Hi dazınt hev ı cab","tense":"Present Simple","collocations":"doesn't have a job, no job","synonyms":"work, occupation","antonyms":"unemployment","commonMistake":"He hasn't a job. ❌ (eski)","aiExplain":"He hasn't a job doğru ama çok resmi ve eskidir.","grammarTags":"have, negative, auxiliary","imgQuery":"person looking at job ads"},{"id":"A1-M04-P1-023","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":23,"level":"A1","topic":"Possession","scenario":"First person plural negative","grammar":"We + don't have + noun","highlights":"Don't have ile çoğul negatif","pattern":"","en":"We don't have enough time.","tr":"Yeterli vaktimiz yok.","ipa":"/wi doʊnt hæv ɪˈnʌf taɪm/","trPron":"Vi dont hev inaf taym","tense":"Present Simple","collocations":"don't have enough, enough time","synonyms":"hour, moment","antonyms":"none","commonMistake":"We don't enough time. ❌","aiExplain":"Don't tek başına yeterli değildir. \"We don't enough time\" yanlıştır.","grammarTags":"have, negative, auxiliary","imgQuery":"person looking at clock rushing"},{"id":"A1-M04-P1-024","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":24,"level":"A1","topic":"Possession","scenario":"Third person plural question","grammar":"Do + they + have + any + noun?","highlights":"Any ile çoğul soru","pattern":"","en":"Do they have any children?","tr":"Çocukları var mı?","ipa":"/duː ðeɪ hæv ˈɛni ˈʧɪldrən/","trPron":"Du dey hev eni çıldrın","tense":"Present Simple","collocations":"do they have, any children","synonyms":"kid, offspring","antonyms":"parent, adult","commonMistake":"Do they have children? ✔️ (doğru da)","aiExplain":"Any soru cümlelerinde sık kullanılır ama zorunlu değildir.","grammarTags":"have, question, quantifier","imgQuery":"two people with kids"},{"id":"A1-M04-P1-025","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":25,"level":"A1","topic":"Possession","scenario":"First person singular negative question","grammar":"Don't + I + have + noun?","highlights":"Benim ... yok mu? sorusu","pattern":"","en":"Don't I have a choice?","tr":"Seçeneğim yok mu?","ipa":"/doʊnt aɪ hæv ə ʧɔɪs/","trPron":"Dont ay hev ı çoys","tense":"Present Simple","collocations":"don't I have, have a choice","synonyms":"option, alternative","antonyms":"none","commonMistake":"Haven't I a choice? ❌ (eski)","aiExplain":"Don't I have modern İngilizcede doğrudur. \"Haven't I\" eskidir.","grammarTags":"have, question, negative","imgQuery":"person standing with hands up"}]