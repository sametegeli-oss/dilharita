[{"id":"A1-M04-P1-001","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":1,"level":"A1","topic":"Possession","scenario":"Stating ownership of an object","grammar":"Subject + have + noun","highlights":"İlk \"have\" kullanımı - sahiplik","pattern":"","en":"I have a car.","tr":"Bir arabam var.","ipa":"/aɪ hæv ə kɑr/","trPron":"Ay hev ı kar","tense":"Present Simple","collocations":"have a car, own a car","synonyms":"vehicle, automobile","antonyms":"none","commonMistake":"I am a car. ❌","aiExplain":"Have sahiplik bildirir. \"I am a car\" (ben bir arabayım) anlamsızdır. Doğrusu \"I have a car\"dur.","grammarTags":"have, possession, noun","imgQuery":"person standing next to car"},{"id":"A1-M04-P1-002","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":2,"level":"A1","topic":"Family","scenario":"Stating family relationship","grammar":"Subject + have + a/an + family member","highlights":"Aile üyesi sahipliği","pattern":"","en":"I have a sister.","tr":"Bir kız kardeşim var.","ipa":"/aɪ hæv ə ˈsɪstər/","trPron":"Ay hev ı sistır","tense":"Present Simple","collocations":"have a sister, older sister","synonyms":"sibling, kin","antonyms":"brother","commonMistake":"I am a sister. ❌ (anlam farklı)","aiExplain":"Have aile üyesi için kullanılır. \"I am a sister\" ben bir kız kardeşim anlamına gelir, sahiplik değil.","grammarTags":"have, family, noun","imgQuery":"two girls together"},{"id":"A1-M04-P1-003","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":3,"level":"A1","topic":"Possession","scenario":"Third person singular possession","grammar":"Subject (he/she/it) + has + noun","highlights":"Üçüncü tekil şahısta \"has\"","pattern":"","en":"She has a cat.","tr":"Onun bir kedisi var.","ipa":"/ʃiː hæz ə kæt/","trPron":"Şi haz ı ket","tense":"Present Simple","collocations":"has a cat, owns a cat","synonyms":"kitten, feline","antonyms":"dog","commonMistake":"She have a cat. ❌","aiExplain":"He/she/it ile \"has\" kullanılır. \"She have\" yanlıştır.","grammarTags":"have, conjugation, pet","imgQuery":"woman holding a cat"},{"id":"A1-M04-P1-004","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":4,"level":"A1","topic":"Body parts","scenario":"Describing physical features","grammar":"Subject + have + noun (body part)","highlights":"Vücut parçası sahipliği","pattern":"","en":"I have blue eyes.","tr":"Mavi gözlerim var.","ipa":"/aɪ hæv blu aɪz/","trPron":"Ay hev blu ays","tense":"Present Simple","collocations":"have blue eyes, blue-eyed","synonyms":"vision, sight","antonyms":"none","commonMistake":"I am blue eyes. ❌","aiExplain":"Vücut parçaları için de \"have\" kullanılır. \"I am blue eyes\" yanlıştır.","grammarTags":"have, body, noun","imgQuery":"person with blue eyes looking at camera"},{"id":"A1-M04-P1-005","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":5,"level":"A1","topic":"Possession","scenario":"Third person singular possession (object)","grammar":"He + has + a/an + noun","highlights":"Erkek için \"has\"","pattern":"","en":"He has a bicycle.","tr":"Onun bir bisikleti var.","ipa":"/hiː hæz ə ˈbaɪsɪkəl/","trPron":"Hi haz ı baysikıl","tense":"Present Simple","collocations":"has a bicycle, ride a bicycle","synonyms":"cycle, two-wheeler","antonyms":"car","commonMistake":"He have a bicycle. ❌","aiExplain":"He ile \"has\" kullanılır. \"He have\" yanlıştır.","grammarTags":"have, conjugation, object","imgQuery":"boy with bicycle"},{"id":"A1-M04-P1-006","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":6,"level":"A1","topic":"Pets","scenario":"Stating pet ownership","grammar":"Subject + have + a/an + pet","highlights":"Evcil hayvan sahipliği","pattern":"","en":"We have a dog.","tr":"Bir köpeğimiz var.","ipa":"/wi hæv ə dɔg/","trPron":"Vi hev ı dog","tense":"Present Simple","collocations":"have a dog, walk the dog","synonyms":"puppy, canine","antonyms":"cat","commonMistake":"We have dog. ❌","aiExplain":"Sayılabilir tekil isimlerden önce \"a\" kullanılır. \"We have dog\" yanlıştır.","grammarTags":"have, article, pet","imgQuery":"family with golden retriever"},{"id":"A1-M04-P1-007","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":7,"level":"A1","topic":"Possession","scenario":"Plural subject possession","grammar":"They + have + plural noun","highlights":"Çoğul özne ile \"have\"","pattern":"","en":"They have two children.","tr":"Onların iki çocuğu var.","ipa":"/ðeɪ hæv tuː ˈʧɪldrən/","trPron":"Dey hev tu çıldrın","tense":"Present Simple","collocations":"have two children, children are","synonyms":"kid, offspring","antonyms":"parent, adult","commonMistake":"They has two children. ❌","aiExplain":"They çoğul özne olduğu için \"have\" kullanılır. \"They has\" yanlıştır.","grammarTags":"have, plural, family","imgQuery":"couple with two kids"},{"id":"A1-M04-P1-008","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":8,"level":"A1","topic":"Food/Drink","scenario":"Stating what you have to eat/drink","grammar":"Subject + have + noun (food/drink)","highlights":"Yiyecek/içecek sahipliği","pattern":"","en":"I have an apple.","tr":"Bir elmam var.","ipa":"/aɪ hæv æn ˈæpəl/","trPron":"Ay hev en epıl","tense":"Present Simple","collocations":"have an apple, eat an apple","synonyms":"fruit, snack","antonyms":"none","commonMistake":"I have apple. ❌","aiExplain":"Apple sesli harfle başladığı için \"an\" kullanılır. \"I have apple\" yanlıştır.","grammarTags":"have, article, food","imgQuery":"hand holding red apple"},{"id":"A1-M04-P1-009","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":9,"level":"A1","topic":"Possession","scenario":"Third person singular (inanimate)","grammar":"It + has + noun","highlights":"Cansız varlık için \"has\"","pattern":"","en":"It has four legs.","tr":"Onun dört bacağı var.","ipa":"/ɪt hæz fɔr lɛgz/","trPron":"İt haz for legz","tense":"Present Simple","collocations":"has four legs, four legs","synonyms":"limb, appendage","antonyms":"arm","commonMistake":"It have four legs. ❌","aiExplain":"It tekil üçüncü şahıs olduğu için \"has\" kullanılır.","grammarTags":"have, conjugation, body","imgQuery":"table with four legs"},{"id":"A1-M04-P1-010","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":10,"level":"A1","topic":"Family","scenario":"Stating multiple family members","grammar":"Subject + have + number + family member","highlights":"Sayı ile aile üyesi","pattern":"","en":"I have one brother and two sisters.","tr":"Bir erkek ve iki kız kardeşim var.","ipa":"/aɪ hæv wʌn ˈbrʌðər ænd tuː ˈsɪstərz/","trPron":"Ay hev van brazır end tu sistırz","tense":"Present Simple","collocations":"have one brother, have sisters","synonyms":"sibling, kin","antonyms":"sister","commonMistake":"I one brother and two sisters. ❌","aiExplain":"Hava fiili olmadan cümle kurulamaz. \"I one brother\" yanlıştır.","grammarTags":"have, family, number","imgQuery":"family portrait with three children"},{"id":"A1-M04-P1-011","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":11,"level":"A1","topic":"Possession","scenario":"First person plural possession","grammar":"We + have + noun","highlights":"Bizim ... var","pattern":"","en":"We have a new teacher.","tr":"Yeni bir öğretmenimiz var.","ipa":"/wi hæv ə nuː ˈtiʧər/","trPron":"Vi hev ı nu tiçır","tense":"Present Simple","collocations":"have a new, new teacher","synonyms":"instructor, educator","antonyms":"student","commonMistake":"We have new teacher. ❌","aiExplain":"Sayılabilir tekil isimlerden önce \"a\" kullanılır.","grammarTags":"have, article, profession","imgQuery":"students with new teacher"},{"id":"A1-M04-P1-012","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":12,"level":"A1","topic":"Body parts","scenario":"Third person body part","grammar":"He + has + noun (body part)","highlights":"Onun ... var (vücut)","pattern":"","en":"He has brown hair.","tr":"Onun kahverengi saçları var.","ipa":"/hiː hæz braʊn hɛr/","trPron":"Hi haz braun her","tense":"Present Simple","collocations":"has brown hair, long hair","synonyms":"mane, locks","antonyms":"bald","commonMistake":"He have brown hair. ❌","aiExplain":"He ile \"has\" kullanılır. \"He have\" yanlıştır.","grammarTags":"have, conjugation, body","imgQuery":"man with brown hair"},{"id":"A1-M04-P1-013","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":13,"level":"A1","topic":"Possession","scenario":"Negative form (I)","grammar":"Subject + do not have + noun","highlights":"Negatif \"have\" - \"don't have\"","pattern":"","en":"I don't have a phone.","tr":"Telefonum yok.","ipa":"/aɪ doʊnt hæv ə foʊn/","trPron":"Ay dont hev ı fon","tense":"Present Simple","collocations":"don't have a phone, no phone","synonyms":"cell, mobile","antonyms":"none","commonMistake":"I have not a phone. ❌ (eski İngilizce)","aiExplain":"Modern İngilizcede negatif \"don't have\" ile yapılır. \"I have not a phone\" doğru ama çok eskidir.","grammarTags":"have, negative, auxiliary","imgQuery":"person without phone"},{"id":"A1-M04-P1-014","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":14,"level":"A1","topic":"Possession","scenario":"Negative form (she)","grammar":"Subject + does not have + noun","highlights":"Doesn't have ile negatif","pattern":"","en":"She doesn't have a car.","tr":"Onun arabası yok.","ipa":"/ʃiː ˈdʌzənt hæv ə kɑr/","trPron":"Şi dazınt hev ı kar","tense":"Present Simple","collocations":"doesn't have a car, no car","synonyms":"vehicle, automobile","antonyms":"none","commonMistake":"She hasn't a car. ❌ (İngiliz İngilizcesinde nadir)","aiExplain":"She hasn't a car çok resmi ve eskidir. Modern İngilizcede \"doesn't have\" kullanılır.","grammarTags":"have, negative, auxiliary","imgQuery":"woman walking in rain"},{"id":"A1-M04-P1-015","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":15,"level":"A1","topic":"Possession","scenario":"Question form (you)","grammar":"Do + you + have + noun?","highlights":"Soru formu \"Do you have\"","pattern":"","en":"Do you have a pen?","tr":"Kalemin var mı?","ipa":"/duː juː hæv ə pɛn/","trPron":"Du yu hev ı pen","tense":"Present Simple","collocations":"do you have, have a pen","synonyms":"writing tool","antonyms":"pencil","commonMistake":"Have you a pen? ❌ (eski)","aiExplain":"Have you a pen? çok resmi ve eskidir. Modern İngilizcede \"Do you have a pen?\" kullanılır.","grammarTags":"have, question, auxiliary","imgQuery":"hand holding a pen"},{"id":"A1-M04-P1-016","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":16,"level":"A1","topic":"Possession","scenario":"Question form (he)","grammar":"Does + he + have + noun?","highlights":"Does he have ile soru","pattern":"","en":"Does he have a laptop?","tr":"Onun laptopu var mı?","ipa":"/dʌz hiː hæv ə ˈlæptɑp/","trPron":"Daz hi hev ı laptop","tense":"Present Simple","collocations":"does he have, have a laptop","synonyms":"computer, notebook","antonyms":"desktop","commonMistake":"Has he a laptop? ❌ (eski)","aiExplain":"Has he a laptop? doğru ama çok resmi. Modern İngilizcede \"Does he have a laptop?\" kullanılır.","grammarTags":"have, question, auxiliary","imgQuery":"person working on laptop"},{"id":"A1-M04-P1-017","module":"A1-M04 Have / Has · P1","part":"P1 Foundation","stage":"Foundation","order":17,"level":"A1","topic":"Possession","scenario":"Question form (they)","grammar":"Do + they + have + noun?","highlights":"Do they have ile soru","pattern":"","en":"Do they have a garden?","tr":"Bahçeleri var mı?","ipa":"/duː ðeɪ hæv ə ˈgɑrdən/","trPron":"Du dey hev ı gardın","tense":"Present Simple","collocations":"do they have, have a garden","synonyms":"yard, backyard","antonyms":"none","commonMistake":"They have a garden? ❌","a