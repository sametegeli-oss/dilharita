[{"id":"A1-M02-P1-001","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":1,"level":"A1","topic":"Negation","scenario":"Stating you're not something","grammar":"Subject + am not + noun","highlights":"am not ile ilk negatif cümle","pattern":"","en":"I am not a child.","tr":"Ben bir çocuk değilim.","ipa":"/aɪ æm nɑt ə tʃaɪld/","trPron":"Ay em nat ı çayld","tense":"Present Simple","collocations":"not a child, like a child","synonyms":"kid, minor","antonyms":"adult, grown-up","commonMistake":"I am not no child. ❌","aiExplain":"Negatif cümlede \"not\" tek başına yeterlidir. \"I am not no child\" çift negatif yapar ve yanlıştır.","grammarTags":"be, negative, noun","imgQuery":"person standing away from playground"},{"id":"A1-M02-P1-002","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":2,"level":"A1","topic":"Negation","scenario":"Denying a feeling","grammar":"Subject + am not + adjective","highlights":"Duygu negatifi","pattern":"","en":"I am not hungry.","tr":"Aç değilim.","ipa":"/aɪ æm nɑt ˈhʌŋgri/","trPron":"Ay em nat hangri","tense":"Present Simple","collocations":"not hungry, feel hungry","synonyms":"starving, famished","antonyms":"full, stuffed","commonMistake":"I not hungry. ❌","aiExplain":"Not tek başına fiil görevi görmez. \"I not hungry\" yanlıştır.","grammarTags":"be, negative, adjective","imgQuery":"person pushing away food plate"},{"id":"A1-M02-P1-003","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":3,"level":"A1","topic":"Negation","scenario":"Denying profession","grammar":"Subject + isn't + article + noun","highlights":"isn't ile meslek negatifi","pattern":"","en":"She isn't a doctor.","tr":"O bir doktor değil.","ipa":"/ʃiː ˈɪzənt ə ˈdɑktər/","trPron":"Şi izınt ı daktır","tense":"Present Simple","collocations":"isn't a, not a doctor","synonyms":"physician, medic","antonyms":"patient, nurse","commonMistake":"She is no doctor. ❌ (farklı anlam)","aiExplain":"She is no doctor edebi bir ifadedir, standart negatif \"She isn't a doctor\"dur.","grammarTags":"be, negative, contraction","imgQuery":"person in casual clothes with stethoscope down"},{"id":"A1-M02-P1-004","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":4,"level":"A1","topic":"Negation","scenario":"Denying location","grammar":"Subject + aren't + preposition + noun","highlights":"aren't ile yer negatifi","pattern":"","en":"We aren't at home.","tr":"Evde değiliz.","ipa":"/wi ɑrnt æt hoʊm/","trPron":"Wi arnt et hom","tense":"Present Simple","collocations":"aren't at, not at home","synonyms":"house, residence","antonyms":"out, away","commonMistake":"We aren't home. ❌ (Amerikan İngilizcesinde geçer)","aiExplain":"Standart İngilizcede \"at home\" doğrudur. \"Aren't home\" Amerikan İngilizcesinde kabul edilir.","grammarTags":"be, negative, preposition","imgQuery":"family outside their house with closed door"},{"id":"A1-M02-P1-005","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":5,"level":"A1","topic":"Negation","scenario":"Denying identity","grammar":"Subject + isn't + name","highlights":"İsim negatifi","pattern":"","en":"His name isn't John.","tr":"Onun adı John değil.","ipa":"/hɪz neɪm ˈɪzənt ʤɑn/","trPron":"Hiz neym izınt Can","tense":"Present Simple","collocations":"isn't John, name isn't","synonyms":"title, label","antonyms":"anonymous","commonMistake":"His name no is John. ❌","aiExplain":"No is yapısı yanlıştır. Doğru negatif \"isn't\" veya \"is not\" kullanmaktır.","grammarTags":"be, negative, possession","imgQuery":"person looking at blank name tag"},{"id":"A1-M02-P1-006","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":6,"level":"A1","topic":"Negation","scenario":"Denying possession","grammar":"Subject + aren't + possessive + noun","highlights":"İyelik negatifi","pattern":"","en":"They aren't my keys.","tr":"Onlar benim anahtarlarım değil.","ipa":"/ðeɪ ɑrnt maɪ kiz/","trPron":"Dey arnt may kiz","tense":"Present Simple","collocations":"aren't my, not my keys","synonyms":"opener, entry","antonyms":"none","commonMistake":"They are no my keys. ❌","aiExplain":"No my keys yanlıştır. Doğrusu \"not my keys\" veya \"aren't my keys\"dir.","grammarTags":"be, negative, possessive","imgQuery":"hand holding unknown keys"},{"id":"A1-M02-P1-007","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":7,"level":"A1","topic":"Negation","scenario":"Denying a statement","grammar":"Short negative answer","highlights":"Kısa negatif cevap (isn't)","pattern":"","en":"No, it isn't.","tr":"Hayır, değil.","ipa":"/noʊ ɪt ˈɪzənt/","trPron":"No it izınt","tense":"Present Simple","collocations":"no it isn't, it isn't","synonyms":"negative","antonyms":"yes, positive","commonMistake":"No. ❌ (eksik)","aiExplain":"Sadece \"No\" demek yeterli değildir. Kısa cevap \"No, it isn't\" doğrudur.","grammarTags":"be, negative, short-answer","imgQuery":"person shaking head"},{"id":"A1-M02-P1-008","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":8,"level":"A1","topic":"Negation","scenario":"Short negative answer (aren't)","grammar":"Kısa negatif cevap (aren't)","highlights":"No, we aren't ready.","pattern":"Present Simple","en":"aren't ready, not ready","tr":"ready, readiness, readily","ipa":"prepared, set","trPron":"unready","tense":"A1","collocations":"A1","synonyms":"Apologetic","antonyms":"We not ready yanlıştır çünkü \"not\" tek başına fiil değildir.","commonMistake":"","aiExplain":"team looking at unfinished project","grammarTags":"","imgQuery":"clock ticking sound"},{"id":"A1-M02-P1-009","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":9,"level":"A1","topic":"Negation","scenario":"Denying a description","grammar":"Subject + am not + adjective + at all","highlights":"At all ile vurgulu negatif","pattern":"","en":"I am not tired at all.","tr":"Hiç yorgun değilim.","ipa":"/aɪ æm nɑt ˈtaɪərd æt ɔl/","trPron":"Ay em nat tayırd et ol","tense":"Present Simple","collocations":"not at all, not tired","synonyms":"exhausted, weary","antonyms":"energetic, rested","commonMistake":"I am not at all tired. ✔️ (doğru da)","aiExplain":"Not at all genellikle sıfattan önce veya sonra gelebilir. Her ikisi de doğrudur.","grammarTags":"be, negative, emphasis","imgQuery":"person running on treadmill"},{"id":"A1-M02-P1-010","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":10,"level":"A1","topic":"Negation","scenario":"Denying a relationship","grammar":"Subject + isn't + possessive + noun","highlights":"Aile ilişkisi negatifi","pattern":"","en":"She isn't my sister.","tr":"O benim kız kardeşim değil.","ipa":"/ʃiː ˈɪzənt maɪ ˈsɪstər/","trPron":"Şi izınt may sistır","tense":"Present Simple","collocations":"isn't my, not my sister","synonyms":"sibling, kin","antonyms":"brother, none","commonMistake":"She is no my sister. ❌","aiExplain":"She is no my sister yapısı yanlıştır. \"No\" isimden önce gelir ama iyelikten önce gelmez.","grammarTags":"be, negative, possessive","imgQuery":"two girls standing apart"},{"id":"A1-M02-P1-011","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":11,"level":"A1","topic":"Negation","scenario":"Denying existence","grammar":"There + isn't + singular noun","highlights":"There isn't tekiller için","pattern":"","en":"There isn't a bathroom here.","tr":"Burada banyo yok.","ipa":"/ðɛr ˈɪzənt ə ˈbæθrum hɪr/","trPron":"Der izınt ı batrum hir","tense":"Present Simple","collocations":"isn't a, no bathroom","synonyms":"restroom, toilet","antonyms":"none","commonMistake":"There hasn't a bathroom. ❌","aiExplain":"There hasn't yanlıştır. Varlık yokluğu \"There isn't\" ile belirtilir.","grammarTags":"be, negative, there-is","imgQuery":"person looking for restroom in hallway"},{"id":"A1-M02-P1-012","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":12,"level":"A1","topic":"Negation","scenario":"Denying multiple existence","grammar":"There + aren't + plural noun","highlights":"There aren't çoğullar için","pattern":"","en":"There aren't any towels in the room.","tr":"Odada hiç havlu yok.","ipa":"/ðɛr ɑrnt ˈɛni ˈtaʊəlz ɪn ðə rum/","trPron":"Der arnt eni tauıls in dı rum","tense":"Present Simple","collocations":"aren't any, any towels","synonyms":"cloth, wipe","antonyms":"none","commonMistake":"There isn't any towels. ❌","aiExplain":"Towels çoğul olduğu için \"isn't\" değil \"aren't\" kullanılır.","grammarTags":"be, negative, there-are","imgQuery":"empty bathroom shelf"},{"id":"A1-M02-P1-013","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":13,"level":"A1","topic":"Negation","scenario":"Denying a fact","grammar":"Subject + am not + noun + (I am + positive)","highlights":"Kontrast cümlesi","pattern":"","en":"I am not a student; I am a teacher.","tr":"Ben öğrenci değilim; ben öğretmenim.","ipa":"/aɪ æm nɑt ə ˈstudənt aɪ æm ə ˈtiʧər/","trPron":"Ay em nat ı studınt ay em ı tiçır","tense":"Present Simple","collocations":"not a student, am a teacher","synonyms":"learner, pupil","antonyms":"teacher, master","commonMistake":"I not a student; I a teacher. ❌","aiExplain":"İki cümlede de \"am\" fiili gerekir. \"I not a student\" yanlıştır.","grammarTags":"be, negative, contrast","imgQuery":"person with teacher ID card"},{"id":"A1-M02-P1-014","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":14,"level":"A1","topic":"Negation","scenario":"Denying a price","grammar":"Subject + isn't + number + currency","highlights":"Fiyat negatifi","pattern":"","en":"It isn't five dollars; it's three.","tr":"Beş dolar değil; üç.","ipa":"/ɪt ˈɪzənt faɪv ˈdɑlərz ɪts θri/","trPron":"İt izınt fayv dalırs its tri","tense":"Present Simple","collocations":"isn't five, it's three","synonyms":"currency, buck","antonyms":"cent, penny","commonMistake":"It no five dollars. ❌","aiExplain":"It no five dollars tamamen yanlıştır. Doğrusu \"It isn't five dollars\"dur.","grammarTags":"be, negative, number","imgQuery":"price tag with crossed out 5"},{"id":"A1-M02-P1-015","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":15,"level":"A1","topic":"Negation","scenario":"Denying a location","grammar":"Subject + isn't + here/there","highlights":"Burada/yok negatifi","pattern":"","en":"He isn't here right now.","tr":"O şu anda burada değil.","ipa":"/hiː ˈɪzənt hɪr raɪt naʊ/","trPron":"Hi izınt hir rayt nau","tense":"Present Simple","collocations":"isn't here, right now","synonyms":"present, available","antonyms":"there, absent","commonMistake":"He not here. ❌","aiExplain":"He not here yanlıştır. \"He isn't here\" doğrudur.","grammarTags":"be, negative, location","imgQuery":"empty chair in office"},{"id":"A1-M02-P1-016","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":16,"level":"A1","topic":"Negation","scenario":"Denying an emotion (plural)","grammar":"Subject + aren't + adjective","highlights":"Çoğul özne ile negatif duygu","pattern":"","en":"The children aren't scared.","tr":"Çocuklar korkmuş değil.","ipa":"/ðə ˈʧɪldrən ɑrnt skɛrd/","trPron":"Dı çıldrın arnt skerd","tense":"Present Simple","collocations":"aren't scared, not scared","synonyms":"frightened, afraid","antonyms":"brave, fearless","commonMistake":"The children isn't scared. ❌","aiExplain":"Children çoğul olduğu için \"isn't\" değil \"aren't\" kullanılır.","grammarTags":"be, negative, plural","imgQuery":"children playing without fear"},{"id":"A1-M02-P1-017","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":17,"level":"A1","topic":"Negation","scenario":"Denying a temperature","grammar":"Subject + isn't + adjective + enough","highlights":"Sıcaklık negatifi","pattern":"","en":"The water isn't warm enough.","tr":"Su yeterince ılık değil.","ipa":"/ðə ˈwɔtər ˈɪzənt wɔrm ɪˈnʌf/","trPron":"Dı vatır izınt vorm inaf","tense":"Present Simple","collocations":"isn't warm enough, warm enough","synonyms":"H2O, liquid","antonyms":"ice, none","commonMistake":"The water isn't enough warm. ❌","aiExplain":"Enough sıfattan sonra gelir. \"Enough warm\" yanlıştır.","grammarTags":"be, negative, adverb","imgQuery":"hand under faucet"},{"id":"A1-M02-P1-018","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":18,"level":"A1","topic":"Negation","scenario":"Denying a day","grammar":"Subject + isn't + day","highlights":"Gün negatifi","pattern":"","en":"Today isn't Monday; it's Tuesday.","tr":"Bugün Pazartesi değil; Salı.","ipa":"/təˈdeɪ ˈɪzənt ˈmʌndeɪ ɪts ˈtuzdeɪ/","trPron":"Tudey izınt mandey its tuzdey","tense":"Present Simple","collocations":"isn't Monday, it's Tuesday","synonyms":"day of week","antonyms":"Tuesday, Sunday","commonMistake":"Today no Monday. ❌","aiExplain":"Today no Monday yanlıştır. \"Today isn't Monday\" doğrudur.","grammarTags":"be, negative, time","imgQuery":"calendar with Monday crossed out"},{"id":"A1-M02-P1-019","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":19,"level":"A1","topic":"Negation","scenario":"Denying availability","grammar":"Subject + am not + available + time","highlights":"Müsait olmama","pattern":"","en":"I am not available tomorrow.","tr":"Yarın müsait değilim.","ipa":"/aɪ æm nɑt əˈveɪləbəl təˈmɑroʊ/","trPron":"Ay em nat ıveylıbıl tumaro","tense":"Present Simple","collocations":"not available, available tomorrow","synonyms":"free, reachable","antonyms":"busy, occupied","commonMistake":"I not available tomorrow. ❌","aiExplain":"I not available yanlıştır. \"I am not available\" doğrudur.","grammarTags":"be, negative, time","imgQuery":"person looking at busy calendar"},{"id":"A1-M02-P1-020","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":20,"level":"A1","topic":"Negation","scenario":"Denying a relationship status","grammar":"Subject + isn't + married + to","highlights":"Evli olmama (Türk hatası)","pattern":"","en":"She isn't married to him.","tr":"O, onunla evli değil.","ipa":"/ʃiː ˈɪzənt ˈmærid tu hɪm/","trPron":"Şi izınt merid tu him","tense":"Present Simple","collocations":"isn't married to, married to","synonyms":"wedded to, espoused","antonyms":"single, divorced","commonMistake":"She isn't married with him. ❌ (Türk öğrenci hatası)","aiExplain":"Married with yanlıştır. Doğrusu \"married to\"dur. Bu Türk öğrencilerin sık yaptığı bir hatadır.","grammarTags":"be, negative, preposition","imgQuery":"couple standing apart"},{"id":"A1-M02-P1-021","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":21,"level":"A1","topic":"Negation","scenario":"Denying a taste","grammar":"Subject + isn't + adjective","highlights":"Lezzet negatifi","pattern":"","en":"The coffee isn't sweet.","tr":"Kahve tatlı değil.","ipa":"/ðə ˈkɔfi ˈɪzənt swit/","trPron":"Dı kofi izınt swit","tense":"Present Simple","collocations":"isn't sweet, not sweet","synonyms":"java, brew","antonyms":"tea, none","commonMistake":"The coffee no sweet. ❌","aiExplain":"The coffee no sweet yanlıştır. \"Isn't sweet\" doğrudur.","grammarTags":"be, negative, adjective","imgQuery":"cup of black coffee"},{"id":"A1-M02-P1-022","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":22,"level":"A1","topic":"Negation","scenario":"Denying an object's identity","grammar":"Subject + isn't + a/an + noun","highlights":"Eşya tanımı negatifi","pattern":"","en":"This isn't a taxi; it's a bus.","tr":"Bu taksi değil; otobüs.","ipa":"/ðɪs ˈɪzənt ə ˈtæksi ɪts ə bʌs/","trPron":"Dis izınt ı teksi its ı bas","tense":"Present Simple","collocations":"isn't a taxi, it's a bus","synonyms":"cab, car","antonyms":"bus, train","commonMistake":"This not a taxi. ❌","aiExplain":"This not a taxi yanlıştır. \"This isn't a taxi\" doğrudur.","grammarTags":"be, negative, article","imgQuery":"yellow vehicle with taxi sign crossed out"},{"id":"A1-M02-P1-023","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":23,"level":"A1","topic":"Negation","scenario":"Denying a noise","grammar":"Subject + isn't + adjective + enough","highlights":"Ses negatifi","pattern":"","en":"The music isn't loud enough.","tr":"Müzik yeterince yüksek değil.","ipa":"/ðə ˈmjuzɪk ˈɪzənt laʊd ɪˈnʌf/","trPron":"Dı myuzik izınt laud inaf","tense":"Present Simple","collocations":"isn't loud enough, loud enough","synonyms":"sound, tune","antonyms":"silence, quiet","commonMistake":"The music isn't enough loud. ❌","aiExplain":"Enough her zaman sıfattan sonra gelir. \"Enough loud\" yanlıştır.","grammarTags":"be, negative, adverb","imgQuery":"person turning up volume knob"},{"id":"A1-M02-P1-024","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":24,"level":"A1","topic":"Negation","scenario":"Denying a color","grammar":"Subject + isn't + color","highlights":"Renk negatifi","pattern":"","en":"The sky isn't blue today.","tr":"Bugün gökyüzü mavi değil.","ipa":"/ðə skaɪ ˈɪzənt blu təˈdeɪ/","trPron":"Dı skay izınt blu tudey","tense":"Present Simple","collocations":"isn't blue, not blue","synonyms":"azure, navy","antonyms":"gray, cloudy","commonMistake":"The sky no blue. ❌","aiExplain":"The sky no blue yanlıştır. Doğrusu \"The sky isn't blue\"dur.","grammarTags":"be, negative, adjective","imgQuery":"gray cloudy sky"},{"id":"A1-M02-P1-025","module":"A1-M02 Be Verb Negative · P1","part":"P1 Foundation","stage":"Foundation","order":25,"level":"A1","topic":"Negation","scenario":"Denying an inclusion","grammar":"Subject + aren't + included","highlights":"Dahil olmama","pattern":"","en":"The batteries aren't included.","tr":"Piller dahil değil.","ipa":"/ðə ˈbætəriz ɑrnt ɪnˈkludəd/","trPron":"Dı bateriz arnt inkludıd","tense":"Present Simple","collocations":"aren't included, not included","synonyms":"cell, power source","antonyms":"none","commonMistake":"Batteries no included. ❌","aiExplain":"Batteries no included yanlıştır. \"Aren't included\" doğrudur.","grammarTags":"be, negative, passive","imgQuery":"toy box with battery note"}]