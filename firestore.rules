rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /progress/{userId} {
      allow read, write: if owns(userId);
    }

    match /settings/{userId} {
      allow read, write: if owns(userId);
    }

    match /users/{userId} {
      allow read, write: if owns(userId);

      match /{document=**} {
        allow read, write: if owns(userId);
      }
    }
  }
}
