[{"id":"A1-M01-P1-001","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":1,"level":"A1","topic":"Introductions","scenario":"Meeting someone new","grammar":"Subject + be verb + name","highlights":"First use of be verb; capitalizing \"I\"","pattern":"I am [name].","en":"I am Alex.","tr":"Ben Alex’im.","ipa":"/aɪ æm ˈælɛks/","trPron":"Ay em Aleks","tense":"Present Simple","collocations":"I am, you are, he is","synonyms":"I’m, I am","antonyms":"you aren’t, I’m not","commonMistake":"I Alex. ❌","aiExplain":"“am” sadece “I” ile kullanılır. İngilizce’de cümle kurarken mutlaka bir fiil gerekir. “I Alex” yanlıştır çünkü fiil yok. Doğrusu “I am Alex” olmalıdır.","grammarTags":"be, subject-pronoun, introduction","imgQuery":"person pointing to self"},{"id":"A1-M01-P1-002","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":2,"level":"A1","topic":"Feelings","scenario":"Talking about mood","grammar":"Subject + be verb + adjective","highlights":"","pattern":"Be verb + adjective yapısı","en":"I am happy.","tr":"Mutluyum.","ipa":"/aɪ æm ˈhæpi/","trPron":"Ay em hepi","tense":"Present Simple","collocations":"feel happy, look happy, be happy","synonyms":"glad, pleased","antonyms":"sad, unhappy","commonMistake":"I happy. ❌","aiExplain":"Happy bir sıfattır. İngilizcede sıfatlardan önce be fiili gerekir. “I happy” yanlıştır çünkü sıfat tek başına yüklem olamaz.","grammarTags":"be, adjective, emotion","imgQuery":"smiling student"},{"id":"A1-M01-P1-003","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":3,"level":"A1","topic":"Occupations","scenario":"Meeting someone","grammar":"Subject + be verb + article + noun","highlights":"","pattern":"Mesleklerden önce a/an kullanımı","en":"I am a teacher.","tr":"Ben bir öğretmenim.","ipa":"/aɪ æm ə ˈtiʧər/","trPron":"Ay em ı tiçır","tense":"Present Simple","collocations":"be a teacher, become a teacher","synonyms":"educator, instructor","antonyms":"student","commonMistake":"I am teacher. ❌","aiExplain":"Mesleklerden bahsederken “a” veya “an” kullanılır. “I am teacher” yanlıştır. Doğrusu “I am a teacher” olmalıdır.","grammarTags":"be, article, occupation","imgQuery":"woman at blackboard"},{"id":"A1-M01-P1-004","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":4,"level":"A1","topic":"Location","scenario":"Being at home","grammar":"Subject + be verb + preposition + noun","highlights":"","pattern":"“at home” kalıbı","en":"I am at home.","tr":"Evdeyim.","ipa":"/aɪ æm æt hoʊm/","trPron":"Ay em et hom","tense":"Present Simple","collocations":"stay at home, work at home, be at home","synonyms":"at house, indoors","antonyms":"outside, away","commonMistake":"I home. / I am home. ❌ (home önünde at olmalı)","aiExplain":"Yer bildirirken “at” kullanılır. “I am home” Amerikan İngilizcesinde kabul edilse de standart İngilizcede “I am at home” doğrudur.","grammarTags":"be, preposition, location","imgQuery":"person inside living room"},{"id":"A1-M01-P1-005","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":5,"level":"A1","topic":"Age","scenario":"Talking about age","grammar":"Subject + be verb + number (+ years old)","highlights":"","pattern":"Yaş belirtirken “is” kullanımı","en":"He is twenty years old.","tr":"O yirmi yaşında.","ipa":"/hiː ɪz ˈtwɛnti jɪrz oʊld/","trPron":"Hi iz tventi yırs old","tense":"Present Simple","collocations":"be years old, turn twenty","synonyms":"aged, of age","antonyms":"young, new","commonMistake":"He has twenty years. ❌","aiExplain":"İngilizcede yaş “to have” ile değil, “to be” ile belirtilir. “He has 20 years” yanlıştır. Doğrusu “He is 20 years old”dur.","grammarTags":"be, age, number","imgQuery":"man with birthday cake"},{"id":"A1-M01-P1-006","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":6,"level":"A1","topic":"Origin","scenario":"Where you’re from","grammar":"Subject + be verb + from + country","highlights":"","pattern":"“From” ile köken belirtme","en":"She is from Turkey.","tr":"O Türkiye’dendir.","ipa":"/ʃiː ɪz frʌm ˈtɜrki/","trPron":"Şi iz fıram Türkiye","tense":"Present Simple","collocations":"come from, be originally from","synonyms":"originates from, hails from","antonyms":"none","commonMistake":"She is Turkey. ❌","aiExplain":"Köken belirtirken “from” şarttır. “She is Turkey” yanlıştır. Doğrusu “She is from Turkey” olmalıdır.","grammarTags":"be, preposition, country","imgQuery":"person holding flag map"},{"id":"A1-M01-P1-007","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":7,"level":"A1","topic":"Profession","scenario":"Small talk","grammar":"Subject + be verb + article + noun","highlights":"","pattern":"İş tanımı yaparken a/an","en":"You are a doctor.","tr":"Sen bir doktorsun.","ipa":"/juː ɑr ə ˈdɑktər/","trPron":"Yu ar ı daktır","tense":"Present Simple","collocations":"see a doctor, become a doctor","synonyms":"physician, medical practitioner","antonyms":"patient","commonMistake":"You are doctor. ❌","aiExplain":"“You are doctor” yanlış, “You are a doctor” doğru. Tekil sayılabilir meslek isimlerinden önce “a/an” kullanılır.","grammarTags":"be, article, profession","imgQuery":"person in white coat"},{"id":"A1-M01-P1-008","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":8,"level":"A1","topic":"Identity","scenario":"Calling someone","grammar":"Subject + be verb + name","highlights":"","pattern":"İsim söylerken be fiili","en":"You are Maria, right?","tr":"Sen Maria’sın, değil mi?","ipa":"/juː ɑr mɑˈriə raɪt/","trPron":"Yu ar Mariya rayt","tense":"Present Simple","collocations":"be right, be called","synonyms":"correct, true","antonyms":"wrong, incorrect","commonMistake":"You Maria? ❌","aiExplain":"Soru cümlelerinde de be fiili kullanılır. “You Maria?” sadece çok samimi konuşmada olur, doğru İngilizce “Are you Maria?” veya “You are Maria?” olmalıdır.","grammarTags":"be, question, identity","imgQuery":"two people looking at each other"},{"id":"A1-M01-P1-009","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":9,"level":"A1","topic":"Feelings","scenario":"Asking about well-being","grammar":"Subject + be verb + adjective","highlights":"","pattern":"Sorularda özne-fiil yer değiştirmesi","en":"How are you?","tr":"Nasılsın?","ipa":"/haʊ ɑr juː/","trPron":"Hav ar yu","tense":"Present Simple","collocations":"how are you, feeling well","synonyms":"fine, good, okay","antonyms":"bad, terrible, unwell","commonMistake":"How you are? ❌","aiExplain":"Soru cümlelerinde yardımcı fiil (are) özneden önce gelir. “How you are?” yanlıştır. Doğrusu “How are you?”dur.","grammarTags":"be, question, greeting","imgQuery":"people greeting each other"},{"id":"A1-M01-P1-010","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":10,"level":"A1","topic":"Location","scenario":"Asking for someone","grammar":"Subject + be verb + preposition + noun","highlights":"","pattern":"Present Simple","en":"where is, find him","tr":"where, whereabouts","ipa":"location, position","trPron":"none","tense":"A1","collocations":"Neutral","synonyms":"Soru kelimesi (where) + be fiili (is) + özne (he). “Where he is?” yanlış sıralamadır.","antonyms":"empty chair in room","commonMistake":"A1","aiExplain":"reverberation sound","grammarTags":"","imgQuery":"be, question, location"},{"id":"A1-M01-P1-011","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":11,"level":"A1","topic":"Identification","scenario":"Learning names","grammar":"Subject + be verb + name + possessive","highlights":"","pattern":"Bu birine ait bir şey","en":"This is my book.","tr":"Bu benim kitabım.","ipa":"/ðɪs ɪz maɪ bʊk/","trPron":"Dis iz may buk","tense":"Present Simple","collocations":"my book, read a book","synonyms":"volume, publication","antonyms":"none","commonMistake":"This my book. ❌","aiExplain":"İyelik belirtirken “This my book” yanlıştır. “This is my book” doğrudur çünkü “is” fiili zorunludur.","grammarTags":"be, possessive, demonstrative","imgQuery":"hand holding a book"},{"id":"A1-M01-P1-012","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":12,"level":"A1","topic":"Plural","scenario":"Identifying multiple people","grammar":"Subject + be verb (plural) + noun","highlights":"","pattern":"Çoğul özne ile “are” kullanımı","en":"They are students.","tr":"Onlar öğrencidir.","ipa":"/ðeɪ ɑr ˈstudənts/","trPron":"Dey ar studınts","tense":"Present Simple","collocations":"are students, good students","synonyms":"learners, pupils","antonyms":"teachers","commonMistake":"They is students. ❌","aiExplain":"Çoğul özne (They) ile tekil fiil (is) kullanılmaz. “They is” yanlıştır. Doğrusu “They are” olmalıdır.","grammarTags":"be, plural, noun","imgQuery":"group of students in classroom"},{"id":"A1-M01-P1-013","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":13,"level":"A1","topic":"Feelings","scenario":"Asking about a third person","grammar":"Subject + be verb + adjective","highlights":"","pattern":"Soru formunda “Is he” yapısı","en":"Is he tired?","tr":"O yorgun mu?","ipa":"/ɪz hiː ˈtaɪərd/","trPron":"İz hi tayırd","tense":"Present Simple","collocations":"look tired, feel tired","synonyms":"exhausted, weary","antonyms":"energetic, rested","commonMistake":"He is tired? ❌ (intonation ile soru olabilir ama yanlış)","aiExplain":"Soru cümlesi yaparken yardımcı fiili (is) başa al. “He is tired?” soru işaretiyle konuşma dilinde olabilir ama doğru yazılı soru “Is he tired?”dır.","grammarTags":"be, question, adjective","imgQuery":"person yawning on couch"},{"id":"A1-M01-P1-014","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":14,"level":"A1","topic":"Location","scenario":"Asking about object location","grammar":"Subject + be verb + prepositional phrase","highlights":"","pattern":"“It” ile yer sorma","en":"Is it on the table?","tr":"Masanın üzerinde mi?","ipa":"/ɪz ɪt ɑn ðə ˈteɪbəl/","trPron":"İz it on dı teybıl","tense":"Present Simple","collocations":"on the table, under the table","synonyms":"desk, surface","antonyms":"none","commonMistake":"Is it the table? ❌","aiExplain":"Yer bildiren edatlar (on, in, under) kullanılmazsa anlam bozulur. “Is it the table?” masa olup olmadığını sorar. Doğrusu “Is it on the table?”","grammarTags":"be, question, preposition","imgQuery":"keys on a wooden table"},{"id":"A1-M01-P1-015","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":15,"level":"A1","topic":"Occupation","scenario":"Introducing family member","grammar":"Subject + be verb + article + noun + possessive","highlights":"","pattern":"Aile üyesi tanıtma","en":"She is a friend of my sister.","tr":"O benim kız kardeşimin arkadaşı.","ipa":"/ʃiː ɪz ə frɛnd əv maɪ ˈsɪstər/","trPron":"Şi iz ı frend ov may sistır","tense":"Present Simple","collocations":"best friend, close friend","synonyms":"companion, pal","antonyms":"enemy, foe","commonMistake":"She is my sister friend. ❌","aiExplain":"İyelik yapısı “my sister’s friend” veya “friend of my sister” olabilir. “my sister friend” yanlıştır.","grammarTags":"be, possessive, preposition","imgQuery":"two girls hugging"},{"id":"A1-M01-P1-016","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":16,"level":"A1","topic":"Profession","scenario":"Confirming job","grammar":"Negative contraction","highlights":"","pattern":"Kısa negatif form \"isn't\"","en":"He isn't a lawyer.","tr":"O bir avukat değil.","ipa":"/hiː ˈɪzənt ə ˈlɔɪər/","trPron":"Hi izınt ı loyır","tense":"Present Simple","collocations":"not a lawyer, good lawyer","synonyms":"attorney, counsel","antonyms":"client, defendant","commonMistake":"He isn't no lawyer. ❌","aiExplain":"Negatif cümlede “isn’t” tek başına yeterlidir. “He isn’t no lawyer” çift negatif yapar ve yanlıştır.","grammarTags":"be, negative, contraction","imgQuery":"person in suit shaking head"},{"id":"A1-M01-P1-017","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":17,"level":"A1","topic":"Location","scenario":"Explaining absence","grammar":"Negative with \"not\"","highlights":"","pattern":"“Not” ile negatif yapma","en":"We are not at school today.","tr":"Bugün okulda değiliz.","ipa":"/wiː ɑr nɑt æt skuːl təˈdeɪ/","trPron":"Wi ar nat et skul tudey","tense":"Present Simple","collocations":"not at school, go to school","synonyms":"academy, college","antonyms":"home, work","commonMistake":"We not are at school. ❌","aiExplain":"Negatif yaparken “not” yardımcı fiilden (are) sonra gelir. “We not are” yanlış sıralamadır.","grammarTags":"be, negative, location","imgQuery":"empty school building"},{"id":"A1-M01-P1-018","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":18,"level":"A1","topic":"Feelings","scenario":"Inquiring about a group","grammar":"Question with \"are\" + \"they\"","highlights":"","pattern":"Soru formunda “Are they” yapısı","en":"Are they ready?","tr":"Onlar hazır mı?","ipa":"/ɑr ðeɪ ˈrɛdi/","trPron":"Ar dey redi","tense":"Present Simple","collocations":"get ready, ready to go","synonyms":"prepared, set","antonyms":"unready, unprepared","commonMistake":"They ready? ❌","aiExplain":"“They ready?” soru işaretiyle konuşma dilinde geçer ama standart İngilizcede “Are they ready?” doğrudur.","grammarTags":"be, question, adjective","imgQuery":"two athletes at starting line"},{"id":"A1-M01-P1-019","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":19,"level":"A1","topic":"Possession","scenario":"Borrowing something","grammar":"Possessive with \"my\" and \"your\"","highlights":"","pattern":"İyelik zamirleri","en":"This is my phone and that is your phone.","tr":"Bu benim telefonum ve şu senin telefonun.","ipa":"/ðɪs ɪz maɪ foʊn ænd ðæt ɪz jʊr foʊn/","trPron":"Dis iz may fon end dat iz yur fon","tense":"Present Simple","collocations":"my phone, your phone","synonyms":"cellphone, mobile","antonyms":"none","commonMistake":"This is mine phone. ❌","aiExplain":"“Mine” tek başına kullanılır (“It is mine”), isimden önce kullanılmaz. “Mine phone” yanlıştır. Doğrusu “my phone”dur.","grammarTags":"be, possessive, demonstrative","imgQuery":"two hands holding different phones"},{"id":"A1-M01-P1-020","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":20,"level":"A1","topic":"Profession","scenario":"Family talk","grammar":"Verb conjugation for \"she\"","highlights":"","pattern":"Üçüncü tekil şahıs (she) ile “is”","en":"My sister is an architect.","tr":"Kız kardeşim bir mimardır.","ipa":"/maɪ ˈsɪstər ɪz æn ˈɑrkɪtɛkt/","trPron":"May sistır iz en arkitekt","tense":"Present Simple","collocations":"be an architect, study architecture","synonyms":"designer, planner","antonyms":"none","commonMistake":"My sister are an architect. ❌","aiExplain":"“My sister” tekil üçüncü şahıs olduğu için “are” değil “is” kullanılır.","grammarTags":"be, conjugation, profession","imgQuery":"woman drawing on blueprint"},{"id":"A1-M01-P1-021","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":21,"level":"A1","topic":"Location","scenario":"Describing a city feature","grammar":"There is structure","highlights":"","pattern":"Tekil nesneler için “There is”","en":"There is a park near my house.","tr":"Evimin yakınında bir park var.","ipa":"/ðɛr ɪz ə pɑrk nɪr maɪ haʊs/","trPron":"Der iz ı park nir may haus","tense":"Present Simple","collocations":"near my house, in the park","synonyms":"garden, playground","antonyms":"none","commonMistake":"There has a park. ❌","aiExplain":"Varlık belirtirken “There is/are” kullanılır. “There has” yanlıştır. Türkçe’deki “var” birebir “have” olarak çevrilmez.","grammarTags":"be, there-is, location","imgQuery":"trees and bench in a park"},{"id":"A1-M01-P1-022","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":22,"level":"A1","topic":"Plural existence","scenario":"There are structure","grammar":"Çoğul nesneler için “There are”","highlights":"","pattern":"","en":"There are three cats in the garden.","tr":"Bahçede üç kedi var.","ipa":"/ðɛr ɑr θriː kæts ɪn ðə ˈgɑrdən/","trPron":"Der ar tri kets in dı gardın","tense":"Present Simple","collocations":"in the garden, three cats","synonyms":"kitten, feline","antonyms":"dog, none","commonMistake":"There is three cats. ❌","aiExplain":"Çoğul isimle (three cats) tekil “there is” kullanılmaz. “There is three cats” yanlıştır. Doğrusu “There are three cats”tır.","grammarTags":"be, there-are, plural","imgQuery":"cats playing in grass"},{"id":"A1-M01-P1-023","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":23,"level":"A1","topic":"Identity","scenario":"Wrong assumption correction","grammar":"Negative short answer","highlights":"","pattern":"","en":"No, I'm not the manager.","tr":"Hayır, ben müdür değilim.","ipa":"/noʊ aɪm nɑt ðə ˈmænɪʤər/","trPron":"No ayım nat dı menıcır","tense":"Present Simple","collocations":"be the manager, not the manager","synonyms":"boss, director","antonyms":"employee, worker","commonMistake":"No, I no manager. ❌","aiExplain":"“No, I no manager” yanlıştır çünkü “no” fiil görevi görmez. Doğrusu “No, I’m not the manager” olmalıdır.","grammarTags":"be, negative, short-answer","imgQuery":"person shaking hands"},{"id":"A1-M01-P1-024","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":24,"level":"A1","topic":"Confirmation","scenario":"Double-checking information","grammar":"Tag question? (very basic)","highlights":"Basic tag with “right”","pattern":"","en":"You are here, right?","tr":"Buradasın, değil mi?","ipa":"/juː ɑr hɪr raɪt/","trPron":"Yu ar hir rayt","tense":"Present Simple","collocations":"right here, are here","synonyms":"present, available","antonyms":"there, absent","commonMistake":"You are here, yes? ❌","aiExplain":"Onay sorusu için “right?” kullanımı kolaydır. “You are here, yes?” doğal değildir. Doğrusu “You are here, right?” veya “Are you here?”","grammarTags":"be, question, tag","imgQuery":"person pointing at a spot on ground"},{"id":"A1-M01-P1-025","module":"A1-M01 Be Verb · P1","part":"P1 Foundation","stage":"Foundation","order":25,"level":"A1","topic":"Possession","scenario":"Stating ownership formally","grammar":"Formal \"This is\" for introduction","highlights":"Resmi tanıştırmada “This is”","pattern":"","en":"This is our company's CEO.","tr":"Bu bizim şirketimizin CEO’su.","ipa":"/ðɪs ɪz ˈaʊər ˈkʌmpəniːz siː iː ˈoʊ/","trPron":"Dis iz auır kampınız si i ou","tense":"Present Simple","collocations":"our company, company CEO","synonyms":"firm, corporation","antonyms":"none","commonMistake":"This our company CEO. ❌","aiExplain":"Resmi tanıştırmada “This is” şarttır. “This our CEO” yanlıştır çünkü fiil yoktur.","grammarTags":"be, demonstrative, formal","imgQuery":"businessman shaking hands with group"}]