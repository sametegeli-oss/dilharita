:"Reinforcement","order":7,"level":"A1","topic":"Possession","scenario":"Stating a relationship (your)","grammar":"Your + noun + is + profession","highlights":"Senin ...","pattern":"","en":"Your brother is a chef.","tr":"Senin erkek kardeşin bir aşçı.","ipa":"/jʊr ˈbrʌðər ɪz ə ʃɛf/","trPron":"Yur brazır iz ı şef","tense":"Present Simple","collocations":"your brother, brother is","synonyms":"sibling, kin","antonyms":"sister","commonMistake":"Brother is a chef. ❌","aiExplain":"Your olmadan hangi erkek kardeş olduğu belirsizdir.","grammarTags":"possessive, family, profession","imgQuery":"man in chef uniform"},{"id":"A1-M05-P2-008","module":"A1-M05 Possessives · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":8,"level":"A1","topic":"Possession","scenario":"Answering about ownership (male)","grammar":"Yes, it is + his + noun","highlights":"Evet, onun...","pattern":"","en":"Yes, it is his bicycle.","tr":"Evet, o onun bisikleti.","ipa":"/jɛs ɪt ɪz hɪz ˈbaɪsɪkəl/","trPron":"Yes it iz hiz baysikıl","tense":"Present Simple","collocations":"it is his, his bicycle","synonyms":"cycle, two-wheeler","antonyms":"car","commonMistake":"Yes, it is him bicycle. ❌","aiExplain":"Him bicycle yanlıştır.","grammarTags":"possessive, affirmation, masculine","imgQuery":"man with bicycle"},{"id":"A1-M05-P2-009","module":"A1-M05 Possessives · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":9,"level":"A1","topic":"Possession","scenario":"Answering about ownership (plural)","grammar":"They are + our + noun","highlights":"Onlar bizim...","pattern":"Present Simple","en":"our guests, are our","tr":"guest, guests, guesthouse","ipa":"visitor, company","trPron":"host, none","tense":"Friendly","collocations":"Guests of us yanlıştır.","synonyms":"welcome sound","antonyms":"possessive, plural, people","commonMistake":"A1","aiExplain":"","grammarTags":""},{"id":"A1-M05-P2-010","module":"A1-M05 Possessives · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":10,"level":