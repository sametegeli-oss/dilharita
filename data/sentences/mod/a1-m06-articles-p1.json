[{"id":"A1-M06-P1-001","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":1,"level":"A1","topic":"Profession","scenario":"Introducing a profession","grammar":"Subject + be verb + a/an + noun","highlights":"Mesleklerden önce a/an","pattern":"","en":"I am a doctor.","tr":"Ben bir doktorum.","ipa":"/aɪ æm ə ˈdɑktər/","trPron":"Ay em ı daktır","tense":"Present Simple","collocations":"am a doctor, be a doctor","synonyms":"physician, medic","antonyms":"patient, nurse","commonMistake":"I am doctor. ❌","aiExplain":"Meslek belirtirken \"a\" veya \"an\" kullanılır. \"I am doctor\" yanlıştır.","grammarTags":"article, profession, indefinite","imgQuery":"person in white coat"},{"id":"A1-M06-P1-002","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":2,"level":"A1","topic":"Object","scenario":"Identifying an object","grammar":"This is + a/an + noun","highlights":"Bir nesneyi tanıtma","pattern":"Present Simple","en":"this is a, is a book","tr":"book, books, booking","ipa":"volume, publication","trPron":"none","tense":"Neutral","collocations":"Neutral","synonyms":"hand holding a book","antonyms":"page turning sound","commonMistake":"A1","aiExplain":"article, object, indefinite","grammarTags":""},{"id":"A1-M06-P1-003","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":3,"level":"A1","topic":"Object","scenario":"Identifying an object with vowel sound","grammar":"An + vowel sound noun","highlights":"Sesli harfle başlayan isimlerde \"an\"","pattern":"","en":"This is an apple.","tr":"Bu bir elma.","ipa":"/ðɪs ɪz æn ˈæpəl/","trPron":"Dis iz en epıl","tense":"Present Simple","collocations":"this is an, is an apple","synonyms":"fruit, snack","antonyms":"none","commonMistake":"This is a apple. ❌","aiExplain":"Sesli harf sesiyle başlayan kelimelerden önce \"an\" kullanılır. \"A apple\" yanlıştır.","grammarTags":"article, vowel, indefinite","imgQuery":"hand holding red apple"},{"id":"A1-M06-P1-004","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":4,"level":"A1","topic":"Object","scenario":"Identifying an object (specific)","grammar":"This is + the + noun (specific)","highlights":"Belirli nesne için \"the\"","pattern":"","en":"This is the book I bought yesterday.","tr":"Bu dün aldığım kitap.","ipa":"/ðɪs ɪz ðə bʊk aɪ bɔt ˈjɛstərdeɪ/","trPron":"Dis iz dı buk ay bot yestırdey","tense":"Present Simple","collocations":"is the book, the book I","synonyms":"volume, publication","antonyms":"none","commonMistake":"This is a book I bought yesterday. ❌ (anlam farklı)","aiExplain":"Belirli bir kitaptan bahsediyorsak \"the\" kullanılır.","grammarTags":"article, definite, specific","imgQuery":"person holding a specific book"},{"id":"A1-M06-P1-005","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":5,"level":"A1","topic":"Object","scenario":"First mention vs second mention (a → the)","grammar":"First mention: a/an, second: the","highlights":"İlk bahsedişte a/an, ikincide the","pattern":"","en":"I saw a cat. The cat was black.","tr":"Bir kedi gördüm. Kedi siyahtı.","ipa":"/aɪ sɔ ə kæt ðə kæt wʌz blæk/","trPron":"Ay so ı ket dı ket vaz black","tense":"Past Simple","collocations":"saw a cat, the cat was","synonyms":"kitten, feline","antonyms":"dog","commonMistake":"I saw a cat. A cat was black. ❌","aiExplain":"İlk kez bahsedilen nesne için \"a\", dinleyicinin bildiği nesne için \"the\" kullanılır.","grammarTags":"article, definite, indefinite","imgQuery":"black cat sitting"},{"id":"A1-M06-P1-006","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":6,"level":"A1","topic":"Profession","scenario":"Asking about profession","grammar":"Is he + a/an + noun?","highlights":"Meslek sorusu","pattern":"","en":"Is he an engineer?","tr":"O bir mühendis mi?","ipa":"/ɪz hiː æn ˌɛnʤɪˈnɪr/","trPron":"İz hi en encinır","tense":"Present Simple","collocations":"is he an, an engineer","synonyms":"technician, designer","antonyms":"none","commonMistake":"Is he engineer? ❌","aiExplain":"Meslek sorarken de \"a/an\" kullanılır. \"Is he engineer?\" yanlıştır.","grammarTags":"article, question, profession","imgQuery":"person with hard hat"},{"id":"A1-M06-P1-007","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":7,"level":"A1","topic":"Object","scenario":"Asking about an object","grammar":"Is this + a/an + noun?","highlights":"Bu bir ... mi?","pattern":"","en":"Is this a pen?","tr":"Bu bir kalem mi?","ipa":"/ɪz ðɪs ə pɛn/","trPron":"İz dis ı pen","tense":"Present Simple","collocations":"is this a, a pen","synonyms":"writing tool","antonyms":"pencil","commonMistake":"Is this pen? ❌","aiExplain":"Is this pen? fiil ve article olmadan yanlıştır.","grammarTags":"article, question, object","imgQuery":"hand holding a pen"},{"id":"A1-M06-P1-008","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":8,"level":"A1","topic":"Unique objects","scenario":"Unique objects (sun, moon, world)","grammar":"The + unique noun","highlights":"Eşsiz nesnelerde \"the\"","pattern":"","en":"The sun is very bright today.","tr":"Bugün güneş çok parlak.","ipa":"/ðə sʌn ɪz ˈvɛri braɪt təˈdeɪ/","trPron":"Dı san iz veri brayt tudey","tense":"Present Simple","collocations":"the sun, sun is","synonyms":"shining, brilliant","antonyms":"dim, dark","commonMistake":"A sun is very bright today. ❌","aiExplain":"Dünyada tek olan nesnelerden önce \"the\" kullanılır.","grammarTags":"article, definite, unique","imgQuery":"sunny sky with bright sun"},{"id":"A1-M06-P1-009","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":9,"level":"A1","topic":"Superlative","scenario":"Superlative adjectives","grammar":"The + superlative adjective","highlights":"En üstünlük derecesinde \"the\"","pattern":"","en":"This is the best day of my life.","tr":"Bu hayatımın en iyi günü.","ipa":"/ðɪs ɪz ðə bɛst deɪ əv maɪ laɪf/","trPron":"Dis iz dı best dey ov may layf","tense":"Present Simple","collocations":"the best, best day of","synonyms":"greatest, finest","antonyms":"worst, poorest","commonMistake":"This is best day of my life. ❌","aiExplain":"En üstünlük sıfatlarından önce \"the\" kullanılır.","grammarTags":"article, superlative, definite","imgQuery":"person celebrating achievement"},{"id":"A1-M06-P1-010","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":10,"level":"A1","topic":"Ordinal numbers","scenario":"Ordinal numbers (first, second)","grammar":"The + ordinal number","highlights":"Sıra sayılarından önce \"the\"","pattern":"","en":"He is the first person to arrive.","tr":"Oraya varan ilk kişi o.","ipa":"/hiː ɪz ðə fɜrst ˈpɜrsən tu əˈraɪv/","trPron":"Hi iz dı fırst pörsın tu ırayv","tense":"Present Simple","collocations":"the first, first person","synonyms":"initial, primary","antonyms":"last, final","commonMistake":"He is first person to arrive. ❌","aiExplain":"Sıra sayılarından önce \"the\" kullanılır.","grammarTags":"article, ordinal, definite","imgQuery":"person arriving at door"},{"id":"A1-M06-P1-011","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":11,"level":"A1","topic":"Object with adjective","scenario":"Adjective + noun with article","grammar":"A/An + adjective + noun","highlights":"Sıfatlı isimlerde article","pattern":"","en":"It is a big house.","tr":"Büyük bir ev.","ipa":"/ɪt ɪz ə bɪg haʊs/","trPron":"İt iz ı big haus","tense":"Present Simple","collocations":"is a big, a big house","synonyms":"home, dwelling","antonyms":"apartment","commonMistake":"It is big house. ❌","aiExplain":"Sıfat olsa bile sayılabilir tekil isimlerde \"a\" gereklidir.","grammarTags":"article, adjective, indefinite","imgQuery":"large house with garden"},{"id":"A1-M06-P1-012","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":12,"level":"A1","topic":"Nationality","scenario":"Nationality (singular)","grammar":"A/an + nationality (person)","highlights":"Milliyet belirtirken a/an","pattern":"","en":"She is an American.","tr":"O bir Amerikalı.","ipa":"/ʃiː ɪz æn əˈmɛrɪkən/","trPron":"Şi iz en Amerikın","tense":"Present Simple","collocations":"is an American, an American","synonyms":"US citizen, Yankee","antonyms":"none","commonMistake":"She is American. ❌ (sıfat olarak doğru)","aiExplain":"Milliyet ismi olarak kullanıldığında \"a/an\" gerekir. Sıfat olarak kullanıldığında article gerekmez.","grammarTags":"article, nationality, indefinite","imgQuery":"person with USA flag"},{"id":"A1-M06-P1-013","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":13,"level":"A1","topic":"Food","scenario":"Ordering food","grammar":"I would like + a/an + noun","highlights":"Bir ... almak istiyorum","pattern":"Present Simple","en":"like a coffee, a coffee please","tr":"coffee, coffees, caffeinated","ipa":"java, brew","trPron":"tea, none","tense":"Polite","collocations":"Bir fincan kahve istediğinizde \"a coffee\" kullanılır.","synonyms":"coffee pour sound","antonyms":"article, food, indefinite","commonMistake":"A1","aiExplain":"","grammarTags":""},{"id":"A1-M06-P1-014","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":14,"level":"A1","topic":"Places","scenario":"General places (school, work, home)","grammar":"No article for some places (home, school, work)","highlights":"Bazı yerlerde article yok","pattern":"Present Continuous","en":"going home, am going","tr":"home, homeless, homeward","ipa":"house, residence","trPron":"out, away","tense":"Neutral","collocations":"Home genellikle \"to\" ve \"the\" olmadan kullanılır.","synonyms":"door closing sound","antonyms":"article, zero-article, location","commonMistake":"A1","aiExplain":"","grammarTags":""},{"id":"A1-M06-P1-015","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":15,"level":"A1","topic":"Places","scenario":"General places with no article (school)","grammar":"No article for purpose","highlights":"go to school (purpose) vs go to the school (building)","pattern":"Amaç için article yok","en":"Children go to school every day.","tr":"Çocuklar her gün okula gider.","ipa":"/ˈʧɪldrən goʊ tu skul ˈɛvri deɪ/","trPron":"Çıldrın go tu skul evri dey","tense":"Present Simple","collocations":"go to school, every day","synonyms":"academy, college","antonyms":"home, work","commonMistake":"Children go to the school every day. ❌ (farklı anlam)","aiExplain":"Eğitim amacıyla okula gitmekten bahsederken \"the\" kullanılmaz.","grammarTags":"article, zero-article, purpose","imgQuery":"children with backpacks"},{"id":"A1-M06-P1-016","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":16,"level":"A1","topic":"Places","scenario":"Specific building (the school)","grammar":"The + noun (specific building)","highlights":"Belirli bina için \"the\"","pattern":"","en":"The school near my house is new.","tr":"Evimin yakınındaki okul yeni.","ipa":"/ðə skul nɪr maɪ haʊs ɪz nu/","trPron":"Dı skul nir may haus iz nu","tense":"Present Simple","collocations":"the school near, school near","synonyms":"academy, college","antonyms":"none","commonMistake":"School near my house is new. ❌","aiExplain":"Belirli bir binadan bahsederken \"the\" kullanılır.","grammarTags":"article, definite, location","imgQuery":"school building with playground"},{"id":"A1-M06-P1-017","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":17,"level":"A1","topic":"Meals","scenario":"Meals (breakfast, lunch, dinner)","grammar":"No article for meals","highlights":"Öğünlerde article yok","pattern":"","en":"I eat breakfast at 7 AM.","tr":"Saat 7'de kahvaltı yaparım.","ipa":"/aɪ it ˈbrɛkfəst æt ˈsɛvən eɪm/","trPron":"Ay it brekfıst et sevın ey m","tense":"Present Simple","collocations":"eat breakfast, breakfast at","synonyms":"brunch, meal","antonyms":"dinner, lunch","commonMistake":"I eat the breakfast at 7 AM. ❌","aiExplain":"Öğün isimlerinden önce genellikle article kullanılmaz.","grammarTags":"article, zero-article, meal","imgQuery":"person eating breakfast"},{"id":"A1-M06-P1-018","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":18,"level":"A1","topic":"Languages","scenario":"Languages","grammar":"No article for languages","highlights":"Dillerde article yok","pattern":"","en":"She speaks English very well.","tr":"İngilizceyi çok iyi konuşuyor.","ipa":"/ʃiː spiks ˈɪŋglɪʃ ˈvɛri wɛl/","trPron":"Şi spiks İngliş veri vel","tense":"Present Simple","collocations":"speaks English, English well","synonyms":"language, tongue","antonyms":"none","commonMistake":"She speaks the English very well. ❌","aiExplain":"Dil isimlerinden önce \"the\" kullanılmaz.","grammarTags":"article, zero-article, language","imgQuery":"person speaking at podium"},{"id":"A1-M06-P1-019","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":19,"level":"A1","topic":"Sports","scenario":"Sports and games","grammar":"No article for sports","highlights":"Sporlarda article yok","pattern":"","en":"He plays football every weekend.","tr":"Her hafta sonu futbol oynar.","ipa":"/hiː pleɪz ˈfʊtbɔl ˈɛvri ˈwikɛnd/","trPron":"Hi pleys futbol evri vikend","tense":"Present Simple","collocations":"plays football, football every","synonyms":"soccer, game","antonyms":"basketball, none","commonMistake":"He plays the football every weekend. ❌","aiExplain":"Spor isimlerinden önce \"the\" kullanılmaz.","grammarTags":"article, zero-article, sport","imgQuery":"person kicking football"},{"id":"A1-M06-P1-020","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":20,"level":"A1","topic":"Transport","scenario":"Transportation (by + transport)","grammar":"By + transport = no article","highlights":"By ile ulaşımda article yok","pattern":"","en":"I go to work by bus.","tr":"İşe otobüsle giderim.","ipa":"/aɪ goʊ tu wɜrk baɪ bʌs/","trPron":"Ay go tu vörk bay bas","tense":"Present Simple","collocations":"go by bus, by bus","synonyms":"coach, shuttle","antonyms":"car, train","commonMistake":"I go to work by the bus. ❌","aiExplain":"By ile ulaşım aracı belirtirken article kullanılmaz.","grammarTags":"article, zero-article, transport","imgQuery":"person getting off bus"},{"id":"A1-M06-P1-021","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":21,"level":"A1","topic":"Time","scenario":"Time expressions (next, last, every)","grammar":"No article with next/last/every","highlights":"Zaman ifadelerinde article yok","pattern":"","en":"I will see you next week.","tr":"Gelecek hafta görüşürüz.","ipa":"/aɪ wɪl si juː nɛkst wik/","trPron":"Ay vil si yu nekst vik","tense":"Future Simple","collocations":"next week, see you next","synonyms":"upcoming week","antonyms":"following week","commonMistake":"I will see you the next week. ❌","aiExplain":"Next, \"last\", \"every\" gibi zaman ifadeleriyle article kullanılmaz.","grammarTags":"article, zero-article, time","imgQuery":"two people waving goodbye"},{"id":"A1-M06-P1-022","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":22,"level":"A1","topic":"Noun (h)","scenario":"H with silent vowel sound (hour)","grammar":"An + hour (h silent)","highlights":"Sessiz \"h\" ile başlayan kelimede \"an\"","pattern":"","en":"It will take an hour.","tr":"Bir saat sürecek.","ipa":"/ɪt wɪl teɪk æn ˈaʊər/","trPron":"İt vil teyk en auır","tense":"Future Simple","collocations":"take an hour, an hour","synonyms":"60 minutes, time","antonyms":"minute, second","commonMistake":"It will take a hour. ❌","aiExplain":"Hour kelimesinde 'h' sessiz olduğu için \"an\" kullanılır.","grammarTags":"article, silent-h, vowel","imgQuery":"clock showing one hour"},{"id":"A1-M06-P1-023","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":23,"level":"A1","topic":"Noun (u)","scenario":"U with consonant sound (university)","grammar":"A + university (you-niversity)","highlights":"Ü sesiyle başlayan kelimede \"a\"","pattern":"","en":"She studies at a university.","tr":"Bir üniversitede okuyor.","ipa":"/ʃiː ˈstʌdiz æt ə ˌjunɪˈvɜrsəti/","trPron":"Şi stadiz at ı yunivörsıti","tense":"Present Simple","collocations":"at a university, a university","synonyms":"college, school","antonyms":"none","commonMistake":"She studies at an university. ❌","aiExplain":"University /juː/ sesiyle başladığı için \"a\" kullanılır.","grammarTags":"article, consonant-sound, university","imgQuery":"university campus"},{"id":"A1-M06-P1-024","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":24,"level":"A1","topic":"Generalizations","scenario":"Generalizations with plural nouns","grammar":"Plural noun for generalizations (no article)","highlights":"Genellemelerde çoğul isim (article yok)","pattern":"","en":"Doctors help sick people.","tr":"Doktorlar hasta insanlara yardım eder.","ipa":"/ˈdɑktərz hɛlp sɪk ˈpipəl/","trPron":"Daktırz help sik pipıl","tense":"Present Simple","collocations":"doctors help, help sick","synonyms":"physician, medic","antonyms":"patient, nurse","commonMistake":"The doctors help sick people. ❌ (belirli doktorlar)","aiExplain":"Genelleme yaparken çoğul isim kullanılır ve \"the\" kullanılmaz.","grammarTags":"article, zero-article, generalization","imgQuery":"doctor with patient"},{"id":"A1-M06-P1-025","module":"A1-M06 Articles · P1","part":"P1 Foundation","stage":"Foundation","order":25,"level":"A1","topic":"Generalizations","scenario":"Generalizations with uncountable nouns","grammar":"Uncountable noun for generalizations (no article)","highlights":"Sayılamayanlarda genelleme (article yok)","pattern":"","en":"Water is essential for life.","tr":"Su yaşam için gereklidir.","ipa":"/ˈwɔtər ɪz ɪˈsɛnʃəl fɔr laɪf/","trPron":"Vatır iz esenşıl for layf","tense":"Present Simple","collocations":"water is, essential for life","synonyms":"H2O, liquid","antonyms":"fire, none","commonMistake":"The water is essential for life. ❌ (belirli su)","aiExplain":"Genelleme yaparken sayılamayan isimler article olmadan kullanılır.","grammarTags":"article, zero-article, uncountable","imgQuery":"glass of water"}]