[{"id":"A1-M04-P3-001","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":1,"level":"A1","topic":"Obligation","scenario":"Past obligation (had to)","grammar":"Had to + verb (geçmiş)","highlights":"","pattern":"","en":"I had to wake up early yesterday.","tr":"Dün erken kalkmak zorundaydım.","ipa":"/aɪ hæd tu weɪk ʌp ˈɜrli ˈjɛstərdeɪ/","trPron":"Ay hed tu veyk ap örli yestırdey","tense":"Past Simple","collocations":"had to wake, wake up early","synonyms":"get up, rise","antonyms":"sleep in","commonMistake":"I have to wake up early yesterday. ❌","aiExplain":"Geçmiş zaman zorunluluğu için \"had to\" kullanılır. \"Have to\" şimdiki zamandır.","grammarTags":"have, past, obligation","imgQuery":"person waking up early with alarm"},{"id":"A1-M04-P3-002","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":2,"level":"A1","topic":"Obligation","scenario":"Past negative obligation","grammar":"Didn't have to + verb","highlights":"Geçmişte zorunluluk yok","pattern":"","en":"We didn't have to wait long.","tr":"Uzun süre beklemek zorunda değildik.","ipa":"/wi ˈdɪdənt hæv tu weɪt lɔŋ/","trPron":"Vi didınt hev tu veyt long","tense":"Past Simple","collocations":"didn't have to, have to wait","synonyms":"delay, hold","antonyms":"none","commonMistake":"We hadn't to wait long. ❌ (eski)","aiExplain":"Hadn't to çok eskidir. \"Didn't have to\" modern İngilizcedir.","grammarTags":"have, past, negative","imgQuery":"person leaving quickly"},{"id":"A1-M04-P3-003","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":3,"level":"A1","topic":"Obligation","scenario":"Question with had to","grammar":"Did + you + have to + verb?","highlights":"Geçmişte zorunluluk sorusu","pattern":"","en":"Did you have to pay a fine?","tr":"Ceza ödemek zorunda mıydın?","ipa":"/dɪd juː hæv tu peɪ ə faɪn/","trPron":"Did yu hev tu pey ı fayn","tense":"Past Simple","collocations":"did you have to, have to pay","synonyms":"cost, spend","antonyms":"none","commonMistake":"Had you to pay a fine? ❌ (eski)","aiExplain":"Had you to çok eskidir. \"Did you have to\" modern İngilizcedir.","grammarTags":"have, past, question","imgQuery":"parking ticket on car"},{"id":"A1-M04-P3-004","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":4,"level":"A1","topic":"Possession","scenario":"Have got (alternative)","grammar":"Have got + noun (A1/A2)","highlights":"","pattern":"","en":"I've got a new phone.","tr":"Yeni bir telefonum var.","ipa":"/aɪv gɑt ə nuː foʊn/","trPron":"Ayv gat ı nu fon","tense":"Present Simple","collocations":"ve got, got a new","synonyms":"have, possess","antonyms":"lack, need","commonMistake":"I have a new phone. ✔️ (doğru da)","aiExplain":"Have got \"have\" ile aynı anlamdadır ama daha samimidir. Sadece şimdiki zaman için kullanılır.","grammarTags":"have, possession, contraction","imgQuery":"person holding new smartphone"},{"id":"A1-M04-P3-005","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":5,"level":"A1","topic":"Possession","scenario":"Has got (third person)","grammar":"He's got + noun","highlights":"","pattern":"","en":"She's got blue eyes.","tr":"Onun mavi gözleri var.","ipa":"/ʃiːz gɑt blu aɪz/","trPron":"Şiz gat blu ays","tense":"Present Simple","collocations":"s got, got blue eyes","synonyms":"have, possess","antonyms":"lack, need","commonMistake":"She has blue eyes. ✔️ (doğru da)","aiExplain":"She's got \"she has\" ile aynı anlamdadır. Sadece şimdiki zaman için kullanılır.","grammarTags":"have, possession, contraction","imgQuery":"woman with blue eyes"},{"id":"A1-M04-P3-006","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":6,"level":"A1","topic":"Possession","scenario":"Have got question","grammar":"Have + you + got + noun?","highlights":"Soru formu (have got)","pattern":"","en":"Have you got a minute?","tr":"Bir dakikan var mı?","ipa":"/hæv juː gɑt ə ˈmɪnɪt/","trPron":"Hev yu gat ı minit","tense":"Present Simple","collocations":"have you got, got a minute","synonyms":"moment, second","antonyms":"hour, none","commonMistake":"Do you have a minute? ✔️ (doğru da)","aiExplain":"Have you got \"do you have\" ile aynı anlamdadır. İkisi de doğrudur.","grammarTags":"have, question, contraction","imgQuery":"person tapping watch"},{"id":"A1-M04-P3-007","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":7,"level":"A1","topic":"Possession","scenario":"Have got negative","grammar":"Haven't + got + noun","highlights":"","pattern":"","en":"I haven't got any money.","tr":"Hiç param yok.","ipa":"/aɪ ˈhævənt gɑt ˈɛni ˈmʌni/","trPron":"Ay hevınt gat eni mani","tense":"Present Simple","collocations":"haven't got, got any","synonyms":"cash, currency","antonyms":"none","commonMistake":"I don't have any money. ✔️ (doğru da)","aiExplain":"Haven't got \"don't have\" ile aynı anlamdadır.","grammarTags":"have, negative, contraction","imgQuery":"empty wallet"},{"id":"A1-M04-P3-008","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":8,"level":"A1","topic":"Sickness","scenario":"Have got + illness","grammar":"Have got + a/an + illness","highlights":"","pattern":"","en":"I've got a cold.","tr":"Nezlem var.","ipa":"/aɪv gɑt ə koʊld/","trPron":"Ayv gat ı kold","tense":"Present Simple","collocations":"ve got a, got a cold","synonyms":"flu, virus","antonyms":"health, wellness","commonMistake":"I have a cold. ✔️ (doğru da)","aiExplain":"I've got a cold \"I have a cold\" ile aynı anlamdadır.","grammarTags":"have, illness, contraction","imgQuery":"person sneezing tissue"},{"id":"A1-M04-P3-009","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":9,"level":"A1","topic":"Possession","scenario":"Have got - third person negative","grammar":"Hasn't + got + noun","highlights":"","pattern":"","en":"He hasn't got a job.","tr":"İşi yok.","ipa":"/hiː ˈhæzənt gɑt ə ʤɑb/","trPron":"Hi hazınt gat ı cab","tense":"Present Simple","collocations":"hasn't got, got a job","synonyms":"work, occupation","antonyms":"unemployment","commonMistake":"He doesn't have a job. ✔️ (doğru da)","aiExplain":"Hasn't got \"doesn't have\" ile aynı anlamdadır.","grammarTags":"have, negative, contraction","imgQuery":"person looking at job ads"},{"id":"A1-M04-P3-010","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":10,"level":"A1","topic":"Possession","scenario":"Have got - plural question","grammar":"Have + they + got + noun?","highlights":"Çoğul soru (have got)","pattern":"","en":"Have they got a garden?","tr":"Bahçeleri var mı?","ipa":"/hæv ðeɪ gɑt ə ˈgɑrdən/","trPron":"Hev dey gat ı gardın","tense":"Present Simple","collocations":"have they got, got a garden","synonyms":"yard, backyard","antonyms":"none","commonMistake":"Do they have a garden? ✔️ (doğru da)","aiExplain":"Have they got \"do they have\" ile aynı anlamdadır.","grammarTags":"have, question, contraction","imgQuery":"house with garden"},{"id":"A1-M04-P3-011","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":11,"level":"A1","topic":"Age","scenario":"**Türk hatası - Yaş sorma**","grammar":"How old + are + you? (DOĞRU)","highlights":"Yaş sormada \"have\" KULLANMA!","pattern":"","en":"How old are you? (Not: have)","tr":"Kaç yaşındasın?","ipa":"/haʊ oʊld ɑr juː/","trPron":"Hav old ar yu","tense":"Present Simple","collocations":"how old are, years old","synonyms":"age, aged","antonyms":"young, new","commonMistake":"I have 25 years old. ❌","aiExplain":"**Türk öğrenciler için kritik:** İngilizcede yaş \"have\" ile değil \"be\" ile sorulur. \"How old are you?\" doğru, \"How old do you have?\" yanlıştır.","grammarTags":"have, age, error-focus","imgQuery":"person with birthday cake"},{"id":"A1-M04-P3-012","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":12,"level":"A1","topic":"Age","scenario":"**Türk hatası - Yaş belirtme**","grammar":"Subject + be + number (+ years old)","highlights":"Yaş belirtmede \"have\" KULLANMA!","pattern":"","en":"I am 25 years old. (Not: I have)","tr":"25 yaşındayım.","ipa":"/aɪ æm ˈtwɛnti faɪv jɪrz oʊld/","trPron":"Ay em tventi fayv yırs old","tense":"Present Simple","collocations":"am years old, years old","synonyms":"age, aged","antonyms":"young, new","commonMistake":"I have 25 years old. ❌","aiExplain":"**Türk öğrenciler için kritik:** \"I have 25 years\" yanlıştır. Doğrusu \"I am 25 years old\"dur.","grammarTags":"have, age, error-focus","imgQuery":"person showing age with fingers"},{"id":"A1-M04-P3-013","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":13,"level":"A1","topic":"Possession","scenario":"Have + something + to do","grammar":"Have + noun + to + verb","highlights":"","pattern":"","en":"I have something to tell you.","tr":"Sana söyleyecek bir şeyim var.","ipa":"/aɪ hæv ˈsʌmθɪŋ tu tɛl juː/","trPron":"Ay hev samtİng tu tel yu","tense":"Present Simple","collocations":"have something to, to tell you","synonyms":"thing, item","antonyms":"nothing, none","commonMistake":"I have something tell you. ❌","aiExplain":"Something to tell kalıbında \"to\" mastar eki şarttır.","grammarTags":"have, infinitive, noun","imgQuery":"two people talking"},{"id":"A1-M04-P3-014","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":14,"level":"A1","topic":"Experience","scenario":"Have + no + noun","grammar":"Have no + isim (vurgulu)","highlights":"","pattern":"","en":"I have no idea what you mean.","tr":"Ne demek istediğin hakkında hiçbir fikrim yok.","ipa":"/aɪ hæv noʊ aɪˈdiə wʌt juː min/","trPron":"Ay hev no aydi 99","tense":"Present Simple","collocations":"have no idea, no idea","synonyms":"thought, clue","antonyms":"none","commonMistake":"High","aiExplain":"Have no vurgulu bir yapıdır. \"Don't have any\" de doğrudur.","grammarTags":"have, negation, emphasis","imgQuery":"person shrugging with confusion"},{"id":"A1-M04-P3-015","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":15,"level":"A1","topic":"Experience","scenario":"Have + never + past participle (present perfect basic)","grammar":"Present perfect ile deneyim","highlights":"","pattern":"","en":"I have never been to Paris.","tr":"Hiç Paris'e gitmedim.","ipa":"/aɪ hæv ˈnɛvər bɪn tu pəˈrɪs/","trPron":"Ay hev nevır bin tu Paris","tense":"Present Perfect","collocations":"have never been, never been","synonyms":"visited, traveled","antonyms":"none","commonMistake":"I didn't go to Paris. ❌ (anlam farklı)","aiExplain":"Have never been hayat deneyimini anlatır. \"Didn't go\" belirli bir zamanda gitmediğini söyler.","grammarTags":"have, present-perfect, experience","imgQuery":"Eiffel Tower picture"},{"id":"A1-M04-P3-016","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":16,"level":"A1","topic":"Experience","scenario":"Have + ever + past participle (question)","grammar":"Soru formu - deneyim","highlights":"","pattern":"","en":"Have you ever eaten sushi?","tr":"Hiç suşi yedin mi?","ipa":"/hæv juː ˈɛvər ˈitən ˈsuʃi/","trPron":"Hev yu evır itın suşi","tense":"Present Perfect","collocations":"have you ever, ever eaten","synonyms":"consumed, tasted","antonyms":"none","commonMistake":"Did you ever eat sushi? ✔️ (farklı anlam)","aiExplain":"Have you ever hayat deneyimini sorar. \"Did you ever\" belirli bir zaman dilimini sorar.","grammarTags":"have, present-perfect, question","imgQuery":"sushi plate with chopsticks"},{"id":"A1-M04-P3-017","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":17,"level":"A1","topic":"Obligation","scenario":"Have to - negative question","grammar":"Don't + you + have to + verb?","highlights":"Negatif zorunluluk sorusu","pattern":"","en":"Don't you have to leave early?","tr":"Erken çıkmak zorunda değil misin?","ipa":"/doʊnt juː hæv tu liv ˈɜrli/","trPron":"Dont yu hev tu liv örli","tense":"Present Simple","collocations":"don't you have to, have to leave","synonyms":"depart, go","antonyms":"stay, remain","commonMistake":"Haven't you to leave early? ❌ (eski)","aiExplain":"Don't you have to modern İngilizcede doğrudur.","grammarTags":"have, obligation, question","imgQuery":"person looking at watch at work"},{"id":"A1-M04-P3-018","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":18,"level":"A1","topic":"Sickness","scenario":"Have + a + pain + in + body part","grammar":"Vücut ağrısı","highlights":"","pattern":"","en":"I have a pain in my back.","tr":"Sırtımda ağrı var.","ipa":"/aɪ hæv ə peɪn ɪn maɪ bæk/","trPron":"Ay hev ı peyn in may bek","tense":"Present Simple","collocations":"have a pain, pain in my","synonyms":"ache, soreness","antonyms":"relief, comfort","commonMistake":"I have a pain my back. ❌","aiExplain":"Pain in kalıbında \"in\" şarttır.","grammarTags":"have, illness, preposition","imgQuery":"person holding lower back"},{"id":"A1-M04-P3-019","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":19,"level":"A1","topic":"Time","scenario":"Have + time + to + verb","grammar":"Zaman sahipliği","highlights":"","pattern":"","en":"I don't have time to wait.","tr":"Bekleyecek vaktim yok.","ipa":"/aɪ doʊnt hæv taɪm tu weɪt/","trPron":"Ay dont hev taym tu veyt","tense":"Present Simple","collocations":"don't have time, time to wait","synonyms":"hour, moment","antonyms":"none","commonMistake":"I don't have time wait. ❌","aiExplain":"Time to wait kalıbında \"to\" şarttır.","grammarTags":"have, negative, infinitive","imgQuery":"person looking at impatient person"},{"id":"A1-M04-P3-020","module":"A1-M04 Have / Has · P3","part":"P3 Expansion","stage":"Expansion","order":20,"level":"A1","topic":"Possession","scenario":"Have + enough + noun","grammar":"Yeterli sahipliği","highlights":"","pattern":"","en":"Do we have enough chairs?","tr":"Yeterli sandalyemiz var mı?","ipa":"/duː wi hæv ɪˈnʌf ʧɛrz/","trPron":"Du