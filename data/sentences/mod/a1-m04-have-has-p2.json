[{"id":"A1-M04-P2-001","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":1,"level":"A1","topic":"Food/Drink","scenario":"Having breakfast","grammar":"Subject + have + noun (meal)","highlights":"Öğün sahipliği","pattern":"","en":"I have breakfast at 7 AM.","tr":"Saat 7'de kahvaltı yaparım.","ipa":"/aɪ hæv ˈbrɛkfəst æt ˈsɛvən eɪm/","trPron":"Ay hev brekfıst et sevın ey m","tense":"Present Simple","collocations":"have breakfast, eat breakfast","synonyms":"meal, brunch","antonyms":"dinner, lunch","commonMistake":"I eat breakfast. ✔️ (doğru da)","aiExplain":"Have breakfast ve \"eat breakfast\" ikisi de doğrudur. \"Have\" daha yaygındır.","grammarTags":"have, collocation, meal","imgQuery":"person eating breakfast at table"},{"id":"A1-M04-P2-002","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":2,"level":"A1","topic":"Possession","scenario":"Describing a friend","grammar":"Subject + have + a + adjective + noun","highlights":"Sıfat ile sahiplik","pattern":"","en":"She has a beautiful smile.","tr":"Onun güzel bir gülüşü var.","ipa":"/ʃiː hæz ə ˈbjutəfəl smaɪl/","trPron":"Şi haz ı byutıfıl smayl","tense":"Present Simple","collocations":"has a beautiful, beautiful smile","synonyms":"grin, beam","antonyms":"frown, scowl","commonMistake":"She has beautiful smile. ❌","aiExplain":"Sayılabilir tekil isimden önce \"a\" gereklidir. \"She has beautiful smile\" yanlıştır.","grammarTags":"have, article, adjective","imgQuery":"woman smiling warmly"},{"id":"A1-M04-P2-003","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":3,"level":"A1","topic":"Sickness","scenario":"Stating an illness","grammar":"Subject + have + a/an + illness","highlights":"Hastalık sahipliği","pattern":"","en":"I have a headache.","tr":"Başım ağrıyor.","ipa":"/aɪ hæv ə ˈhɛdeɪk/","trPron":"Ay hev ı hedeyk","tense":"Present Simple","collocations":"have a headache, get a headache","synonyms":"migraine, pain","antonyms":"none","commonMistake":"My head is pain. ❌","aiExplain":"Hastalıklar \"have\" ile belirtilir. \"My head is pain\" İngilizce'de doğal değildir.","grammarTags":"have, illness, noun","imgQuery":"person holding head in pain"},{"id":"A1-M04-P2-004","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":4,"level":"A1","topic":"Sickness","scenario":"Stating a cold","grammar":"Subject + have + a + cold","highlights":"Soğuk algınlığı","pattern":"","en":"He has a cold.","tr":"Onun nezlesi var.","ipa":"/hiː hæz ə koʊld/","trPron":"Hi haz ı kold","tense":"Present Simple","collocations":"has a cold, catch a cold","synonyms":"flu, virus","antonyms":"health, wellness","commonMistake":"He is cold. ❌ (anlam farklı)","aiExplain":"He is cold o üşüyor anlamına gelir. \"He has a cold\" nezlesi var demektir.","grammarTags":"have, illness, article","imgQuery":"person sneezing into tissue"},{"id":"A1-M04-P2-005","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":5,"level":"A1","topic":"Experience","scenario":"Stating an experience","grammar":"Subject + have + noun (experience)","highlights":"Deneyim sahipliği","pattern":"","en":"I have an idea!","tr":"Bir fikrim var!","ipa":"/aɪ hæv æn aɪˈdiə/","trPron":"Ay hev en aydi 98","tense":"Present Simple","collocations":"have an idea, get an idea","synonyms":"thought, concept","antonyms":"none","commonMistake":"Low","aiExplain":"Idea sesli harfle başladığı için \"an\" kullanılır.","grammarTags":"have, article, exclamation","imgQuery":"light bulb above head"},{"id":"A1-M04-P2-006","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":6,"level":"A1","topic":"Possession","scenario":"Stating a feature (it)","grammar":"It + has + noun (feature)","highlights":"Özellik belirtme","pattern":"","en":"It has a big screen.","tr":"Onun büyük bir ekranı var.","ipa":"/ɪt hæz ə bɪg skrin/","trPron":"İt haz ı big skrin","tense":"Present Simple","collocations":"has a big screen, big display","synonyms":"display, monitor","antonyms":"none","commonMistake":"It has big screen. ❌","aiExplain":"Sayılabilir tekil isimden önce \"a\" gereklidir.","grammarTags":"have, article, technology","imgQuery":"smartphone with large screen"},{"id":"A1-M04-P2-007","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":7,"level":"A1","topic":"Family","scenario":"Stating family (we)","grammar":"We + have + number + family member","highlights":"Bizim ailemizde","pattern":"","en":"We have three children.","tr":"Üç çocuğumuz var.","ipa":"/wi hæv θriː ˈʧɪldrən/","trPron":"Vi hev tri çıldrın","tense":"Present Simple","collocations":"have three children, children are","synonyms":"kid, offspring","antonyms":"parent, adult","commonMistake":"We three children. ❌","aiExplain":"We three children fiil olmadığı için yanlıştır.","grammarTags":"have, family, number","imgQuery":"family with three kids"},{"id":"A1-M04-P2-008","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":8,"level":"A1","topic":"Possession","scenario":"Stating a problem","grammar":"Subject + have + a + problem","highlights":"Problem sahipliği","pattern":"","en":"They have a problem with the Wi-Fi.","tr":"Wi-Fi ile ilgili bir sorunları var.","ipa":"/ðeɪ hæv ə ˈprɑbləm wɪð ðə waɪ faɪ/","trPron":"Dey hev ı prablım vit dı vayfay","tense":"Present Simple","collocations":"have a problem, problem with","synonyms":"issue, trouble","antonyms":"solution, answer","commonMistake":"They have problem with the Wi-Fi. ❌","aiExplain":"Sayılabilir tekil isimden önce \"a\" gereklidir.","grammarTags":"have, article, problem","imgQuery":"person staring at laptop with error"},{"id":"A1-M04-P2-009","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":9,"level":"A1","topic":"Possession","scenario":"Negative (we)","grammar":"We + don't have + any + noun","highlights":"Don't have any ile negatif","pattern":"","en":"We don't have any milk left.","tr":"Kalan sütümüz yok.","ipa":"/wi doʊnt hæv ˈɛni mɪlk lɛft/","trPron":"Vi dont hev eni milk left","tense":"Present Simple","collocations":"don't have any, any milk left","synonyms":"dairy, lactose","antonyms":"none","commonMistake":"We don't have milk left. ✔️ (doğru da)","aiExplain":"Any vurgu katar ama zorunlu değildir.","grammarTags":"have, negative, quantifier","imgQuery":"empty milk carton in fridge"},{"id":"A1-M04-P2-010","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":10,"level":"A1","topic":"Possession","scenario":"Negative (they)","grammar":"They + don't have + a/an + noun","highlights":"Negatif sahiplik (çoğul)","pattern":"","en":"They don't have a television.","tr":"Televizyonları yok.","ipa":"/ðeɪ doʊnt hæv ə ˈtɛlɪvɪʒən/","trPron":"Dey dont hev ı telivijın","tense":"Declarative","collocations":"don't have a, have a television","synonyms":"set, screen","antonyms":"none","commonMistake":"They hasn't a television. ❌","aiExplain":"They hasn't yanlıştır. \"They don't have\" doğrudur.","grammarTags":"have, negative, plural","imgQuery":"empty TV stand"},{"id":"A1-M04-P2-011","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":11,"level":"A1","topic":"Question","scenario":"Asking about a feature (he)","grammar":"Does + he + have + a/an + noun?","highlights":"Özellik sorusu","pattern":"","en":"Does he have a car?","tr":"Arabası var mı?","ipa":"/dʌz hiː hæv ə kɑr/","trPron":"Daz hi hev ı kar","tense":"Present Simple","collocations":"does he have, have a car","synonyms":"vehicle, automobile","antonyms":"none","commonMistake":"Has he a car? ❌ (eski)","aiExplain":"Has he a car? doğru ama çok resmi. \"Does he have a car?\" modern İngilizcedir.","grammarTags":"have, question, auxiliary","imgQuery":"man getting out of car"},{"id":"A1-M04-P2-012","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":12,"level":"A1","topic":"Question","scenario":"Asking about a feature (it)","grammar":"Does + it + have + noun?","highlights":"Özellik sorusu (cansız)","pattern":"","en":"Does it have a camera?","tr":"Kamera var mı?","ipa":"/dʌz ɪt hæv ə ˈkæmərə/","trPron":"Daz it hev ı kemırı","tense":"Present Simple","collocations":"does it have, have a camera","synonyms":"lens, device","antonyms":"none","commonMistake":"Has it a camera? ❌ (eski)","aiExplain":"Has it a camera? doğru ama çok resmi.","grammarTags":"have, question, auxiliary","imgQuery":"smartphone with camera lens"},{"id":"A1-M04-P2-013","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":13,"level":"A1","topic":"Sickness","scenario":"Asking about illness","grammar":"Do + you + have + a/an + illness?","highlights":"Hastalık sorusu","pattern":"","en":"Do you have a fever?","tr":"Ateşin var mı?","ipa":"/duː juː hæv ə ˈfivər/","trPron":"Du yu hev ı fivır","tense":"Present Simple","collocations":"do you have, have a fever","synonyms":"temperature, pyrexia","antonyms":"normal, healthy","commonMistake":"Do you have fever? ❌","aiExplain":"Ateş sayılabilir bir isim olarak \"a fever\" şeklinde kullanılır.","grammarTags":"have, question, article","imgQuery":"person touching forehead"},{"id":"A1-M04-P2-014","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":14,"level":"A1","topic":"Possession","scenario":"Negative short answer","grammar":"No + subject + don't/doesn't","highlights":"Kısa negatif cevap","pattern":"","en":"No, she doesn't.","tr":"Hayır, yok.","ipa":"/noʊ ʃiː ˈdʌzənt/","trPron":"No şi dazınt","tense":"Present Simple","collocations":"no she doesn't, she doesn't","synonyms":"negative, no","antonyms":"yes, does","commonMistake":"No, she hasn't. ❌","aiExplain":"Does she have? sorusuna \"No, she hasn't\" yanlıştır.","grammarTags":"have, short-answer, auxiliary","imgQuery":"woman shaking head"},{"id":"A1-M04-P2-015","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":15,"level":"A1","topic":"Possession","scenario":"Positive short answer","grammar":"Yes + subject + do/does","highlights":"Kısa olumlu cevap","pattern":"","en":"Yes, he does.","tr":"Evet, var.","ipa":"/jɛs hiː dʌz/","trPron":"Yes hi daz","tense":"Present Simple","collocations":"yes he does, he does","synonyms":"affirmative, positive","antonyms":"no, doesn't","commonMistake":"Yes, he has. ❌","aiExplain":"Does he have? sorusuna \"Yes, he has\" yanlıştır.","grammarTags":"have, short-answer, auxiliary","imgQuery":"man nodding head"},{"id":"A1-M04-P2-016","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":16,"level":"A1","topic":"Possession","scenario":"Asking about a group (plural)","grammar":"Do + they + have + any + plural noun?","highlights":"Çoğul soru","pattern":"","en":"Do they have any questions?","tr":"Soruları var mı?","ipa":"/duː ðeɪ hæv ˈɛni ˈkwɛsʧənz/","trPron":"Du dey hev eni kuesçınz","tense":"Present Simple","collocations":"do they have, any questions","synonyms":"inquiry, query","antonyms":"answer, response","commonMistake":"Do they have questions? ✔️ (doğru da)","aiExplain":"Any soru cümlelerinde sık kullanılır ama zorunlu değildir.","grammarTags":"have, question, quantifier","imgQuery":"audience raising hands"},{"id":"A1-M04-P2-017","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":17,"level":"A1","topic":"Possession","scenario":"Asking about a person (singular)","grammar":"Does + name + have + a/an + noun?","highlights":"İsim ile soru","pattern":"","en":"Does Ali have a bike?","tr":"Ali'nin bisikleti var mı?","ipa":"/dʌz ˈɑli hæv ə baɪk/","trPron":"Daz Ali hev ı bayk","tense":"Present Simple","collocations":"does Ali have, have a bike","synonyms":"bicycle, cycle","antonyms":"car","commonMistake":"Has Ali a bike? ❌ (eski)","aiExplain":"Has Ali a bike? doğru ama çok resmi. \"Does Ali have\" modern İngilizcedir.","grammarTags":"have, question, auxiliary","imgQuery":"boy with bicycle"},{"id":"A1-M04-P2-018","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":18,"level":"A1","topic":"Food/Drink","scenario":"Asking about food","grammar":"Do + you + have + any + noun?","highlights":"Yiyecek sorusu","pattern":"","en":"Do you have any apples?","tr":"Elman var mı?","ipa":"/duː juː hæv ˈɛni ˈæpəlz/","trPron":"Du yu hev eni epıls","tense":"Present Simple","collocations":"do you have, any apples","synonyms":"fruit, snack","antonyms":"none","commonMistake":"Do you have apples? ✔️ (doğru da)","aiExplain":"Any vurgu katar ama zorunlu değildir.","grammarTags":"have, question, quantifier","imgQuery":"basket of apples"},{"id":"A1-M04-P2-019","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":19,"level":"A1","topic":"Sickness","scenario":"Asking about a third person's illness","grammar":"Does + he/she + have + a/an + illness?","highlights":"Hastalık sorusu (3. tekil)","pattern":"","en":"Does she have a stomachache?","tr":"Onun mide ağrısı var mı?","ipa":"/dʌz ʃiː hæv ə ˈstʌmək eɪk/","trPron":"Daz şi hev ı stamak eyk","tense":"Present Simple","collocations":"does she have, have a stomachache","synonyms":"pain, cramp","antonyms":"none","commonMistake":"Does she have stomachache? ❌","aiExplain":"Mide ağrısı sayılabilir bir isim olarak \"a stomachache\" şeklinde kullanılır.","grammarTags":"have, question, article","imgQuery":"person holding stomach in pain"},{"id":"A1-M04-P2-020","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":20,"level":"A1","topic":"Possession","scenario":"Negative (plural)","grammar":"They + don't have + a/an + noun","highlights":"Negatif sahiplik (çoğul)","pattern":"","en":"They don't have a house.","tr":"Evleri yok.","ipa":"/ðeɪ doʊnt hæv ə haʊs/","trPron":"Dey dont hev ı haus","tense":"Declarative","collocations":"don't have a, have a house","synonyms":"home, dwelling","antonyms":"apartment, none","commonMistake":"They hasn't a house. ❌","aiExplain":"They hasn't yanlıştır.","grammarTags":"have, negative, plural","imgQuery":"empty plot of land"},{"id":"A1-M04-P2-021","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":21,"level":"A1","topic":"Possession","scenario":"Stating a need","grammar":"Subject + have + to + verb (basic)","highlights":"Have to zorunluluk (A1/A2)","pattern":"","en":"I have to go now.","tr":"Şimdi gitmem gerek.","ipa":"/aɪ hæv tu goʊ naʊ/","trPron":"Ay hev tu go nau","tense":"Present Simple","collocations":"have to go, must go","synonyms":"must, need to","antonyms":"don't have to, optional","commonMistake":"I have go now. ❌","aiExplain":"Have to kalıbında \"to\" şarttır. \"I have go\" yanlıştır.","grammarTags":"have, obligation, infinitive","imgQuery":"person looking at clock"},{"id":"A1-M04-P2-022","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":22,"level":"A1","topic":"Obligation","scenario":"Third person obligation","grammar":"He + has + to + verb","highlights":"Has to ile zorunluluk","pattern":"","en":"She has to finish her homework.","tr":"Ödevini bitirmek zorunda.","ipa":"/ʃiː hæz tu ˈfɪnɪʃ hɜr ˈhoʊmwɜrk/","trPron":"Şi haz tu fİnİş hır homvörk","tense":"Present Simple","collocations":"has to finish, finish homework","synonyms":"assignment, task","antonyms":"none","commonMistake":"She have to finish her homework. ❌","aiExplain":"She ile \"has to\" kullanılır. \"She have to\" yanlıştır.","grammarTags":"have, obligation, conjugation","imgQuery":"student doing homework"},{"id":"A1-M04-P2-023","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":23,"level":"A1","topic":"Obligation","scenario":"Negative obligation","grammar":"Don't/doesn't + have to + verb","highlights":"Zorunluluk yok","pattern":"","en":"You don't have to pay now.","tr":"Şimdi ödemek zorunda değilsin.","ipa":"/juː doʊnt hæv tu peɪ naʊ/","trPron":"Yu dont hev tu pey nau","tense":"Present Simple","collocations":"don't have to, have to pay","synonyms":"cost, spend","antonyms":"none","commonMistake":"You mustn't pay now. ❌ (farklı anlam)","aiExplain":"Don't have to zorunluluk olmadığını belirtir. \"Mustn't\" yasak anlamına gelir.","grammarTags":"have, obligation, negative","imgQuery":"person putting wallet away"},{"id":"A1-M04-P2-024","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":24,"level":"A1","topic":"Obligation","scenario":"Question with have to","grammar":"Do + you + have to + verb?","highlights":"Zorunluluk sorusu","pattern":"","en":"Do I have to wear a uniform?","tr":"Üniforma giymek zorunda mıyım?","ipa":"/duː aɪ hæv tu wɛr ə ˈjunɪfɔrm/","trPron":"Du ay hev tu ver ı yunifor","tense":"Present Simple","collocations":"do I have to, have to wear","synonyms":"outfit, dress","antonyms":"none","commonMistake":"Have I to wear a uniform? ❌ (eski)","aiExplain":"Have I to çok eskidir. \"Do I have to\" modern İngilizcedir.","grammarTags":"have, obligation, question","imgQuery":"student with school uniform"},{"id":"A1-M04-P2-025","module":"A1-M04 Have / Has · P2","part":"P2 Reinforcement","stage":"Reinforcement","order":25,"level":"A1","topic":"Obligation","scenario":"Third person negative obligation","grammar":"He + doesn't have to + verb","highlights":"Zorunluluk yok (3. tekil)","pattern":"","en":"He doesn't have to work on Sunday.","tr":"Pazar günü çalışmak zorunda değil.","ipa":"/hiː ˈdʌzənt hæv tu wɜrk ɑn ˈsʌndeɪ/","trPron":"Hi dazınt hev tu vörk on sandey","tense":"Present Simple","collocations":"doesn't have to, have to work","synonyms":"job, labor","antonyms":"rest, relax","commonMistake":"He hasn't to work on Sunday. ❌ (eski)","aiExplain":"Hasn't to çok eskidir. \"Doesn't have to\" modern İngilizcedir.","grammarTags":"have, obligation, negative","imgQuery":"person relaxing on Sunday"}]